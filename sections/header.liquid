<style>
  .country-aesthatc {
    display: flex;
    align-items: center;
    gap: 15px; 
  }

  .world-link-custom {
    text-decoration: none;
    font-family: Satoshi;
    font-weight: 500;
    font-style: Medium;
    font-size: 12px;
    leading-trim: NONE;
    line-height: 100%;
    letter-spacing: 0%;
    color: #3C3C3C;
    white-space: nowrap;
    border-bottom: 1px solid transparent; 
    transition: border-color 0.3s ease;
  }
  .world-link-custom:hover {
    border-color: currentColor;
  }
  .ma-arrow {
    display: flex;
    align-items: center;
    margin-left: 8px;
    transition: transform 0.3s ease;
  }
  
  .ma-flex {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  #MA-lang-opener-desktop:checked + .MA-language-selected .ma-arrow {
    transform: rotate(180deg);
  }
  
  #MA-lang-opener-desktop:not(:checked) ~ .MA-language-options {
    display: none;
  }
  #MA-lang-opener-desktop:checked ~ .MA-language-options {
    display: block;
    position: absolute;
    background: #fff;
    border: 1px solid #e5e5e5;
    z-index: 100;
    min-width: 120px;
    top: 100%;
    right: 0;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Select all your custom language links
    var langLinks = document.querySelectorAll('.ma-option');
    
    langLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault(); // Stop the link from jumping to #
        
        var langCode = this.getAttribute('data-language-code'); // Get 'en' or 'nb'
        var form = this.closest('form'); // Find the parent form
        var input = form.querySelector('input[name="language_code"]'); // Find the hidden input
        
        if(input && form) {
            input.value = langCode; // Set the hidden input value
            form.submit(); // Submit the form to Shopify
        }
      });
    });
  });
</script>

