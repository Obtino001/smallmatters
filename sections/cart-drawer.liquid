<style>
wi-cartdrawer { width: 100%; height: 100dvh; position: fixed; top: 0; left: 0; z-index: 10000; background-color: transparent; justify-content: flex-end; overflow: hidden; display: none; transition: 0.3s ease; font-family: var(--font-body-family), sans-serif; }
.WI_cartDrawerin { height: 100dvh; position: relative; display: flex; justify-content: flex-start; transform: translateX(100%); transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1); }
.WI_cartDrawerin_cart { width: 580px; height: 100%; background-color: rgb(var(--color-background)); z-index: 1; display: flex; flex-direction: column; position: relative; }
.WI_cartDrawerin_upsell { display: none !important; }
.WI_cartDrawerin_cart_header { width: 100%; padding: 24px 24px 16px 24px; border-bottom: 1px solid rgba(var(--color-foreground), 0.08); background-color: rgb(var(--color-background)); }
.WI_cartDrawerin_cart_headerH { width: 100%; margin: 0; display: flex; justify-content: space-between; align-items: center; font-size: 14px; font-weight: 500; color: rgb(var(--color-foreground)); text-transform: uppercase; letter-spacing: 1.5px; }
.WI_cartDrawerin_cart_header_left { display: flex; align-items: center; gap: 8px; }
.WI_cartDrawer_bag_icon { display: flex; align-items: center; }
.WI_cartDrawer_bag_icon svg { width: 18px; height: 18px; }
.WI_cartDrawer_count { font-weight: 600; }
.WI_cartDrawerCls { cursor: pointer; display: flex; align-items: center; color: rgba(var(--color-foreground), 0.55); transition: color 0.2s; }
.WI_cartDrawerCls:hover { color: rgb(var(--color-foreground)); }
.WI_cartDrawerin_cart_header .fsb-section { background-color: transparent !important; padding: 12px 0 0 0 !important; }
.WI_cartDrawerin_cart_header .fsb-container { text-align: left !important; }
.WI_cartDrawerin_cart_header .fsb-text { font-size: 13px !important; color: rgb(var(--color-foreground)) !important; letter-spacing: 0.5px !important; margin: 0 0 8px 0 !important; text-transform: none !important; }
.WI_cartDrawerin_cart_header .fsb-text strong { text-transform: uppercase; font-weight: 700; margin-right: 4px; letter-spacing: 1px; }
.WI_cartDrawerin_cart_header .fsb-money { font-weight: 700; }
.WI_cartDrawerin_cart_header .fsb-progress-track { height: 3px !important; background-color: rgba(var(--color-foreground), 0.08) !important; border-radius: 0 !important; }
.WI_cartDrawerin_cart_header .fsb-progress-fill { background-color: rgb(var(--color-foreground)) !important; border-radius: 0 !important; }
.WI_cartDrawerin_cart_body { flex: 1; position: relative; overflow: hidden; min-height: 0; }
.WI_cartDrawerin_cart_body form { width: 100%; height: 100%; display: flex; flex-direction: column; min-height: 0; }
.WI_cartDrawerin_cart_form_in { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; min-height: 0; padding: 0 24px 24px 24px; }
.WI_cartDrawerin_cart_form_in::-webkit-scrollbar { width: 4px; }
.WI_cartDrawerin_cart_form_in::-webkit-scrollbar-thumb { background: rgba(var(--color-foreground), 0.08); border-radius: 4px; }
.WI_cartDrawerin_cart_empty { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; }
.WI_cartDrawerin_cart_empty_svg { text-align: center; }
.WI_cartDrawerin_cart_empty_svg svg { width: 60px; height: 60px; margin-bottom: 15px; }
.WI_cartDrawerin_cart_empty_svg p { margin: 0; font-size: 14px; color: rgba(var(--color-foreground), 0.55); letter-spacing: 0.5px; }
.WI_cartDrawerin_cart_items { width: 100%; }
.WI_cartDrawer_item { display: flex; gap: 16px; padding: 24px 0; border-bottom: 1px solid rgba(var(--color-foreground), 0.08); position: relative; }
.WI_cartDrawer_item_img { width: 80px; height: 100px; flex-shrink: 0; background-color: rgba(var(--color-foreground), 0.04); }
.WI_cartDrawer_item_img img { width: 100%; height: 100%; object-fit: cover; }
.WI_cartDrawer_item_info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.WI_cartDrawer_item_info_top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
.WI_cartDrawer_item_title { font-size: 14px; font-weight: 500; color: rgb(var(--color-foreground)); text-decoration: none; line-height: 1.3; }
.WI_cartDrawer_item_price { font-size: 14px; font-weight: 500; color: rgb(var(--color-foreground)); text-align: right; white-space: nowrap; }
.WI_cartDrawer_item_price .compare-price { text-decoration: line-through; color: rgba(var(--color-foreground), 0.5); font-size: 12px; margin-right: 6px; }
.WI_cartDrawer_item_options { margin-top: 6px; display: flex; flex-direction: column; gap: 3px; }
.WI_cartDrawer_item_options .option-tag { font-size: 12px; color: rgba(var(--color-foreground), 0.55); }
.WI_cartDrawer_item_info_bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; }
.WI_cartDrawer_quantity { display: flex; align-items: center; border: 1px solid rgba(var(--color-foreground), 0.08); width: 84px; height: 28px; }
.WI_cartDrawer_quantity button { width: 28px; height: 100%; border: none; background: transparent; display: flex; align-items: center; justify-content: center; cursor: pointer; color: rgb(var(--color-foreground)); padding: 0; }
.WI_cartDrawer_quantity button svg { width: 10px; height: 10px; stroke: rgb(var(--color-foreground)); }
.WI_cartDrawer_quantity input { width: 28px; height: 100%; border: none; text-align: center; font-size: 13px; color: rgb(var(--color-foreground)); background: transparent; padding: 0; -moz-appearance: textfield; }
.WI_cartDrawer_quantity input::-webkit-outer-spin-button, .WI_cartDrawer_quantity input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.text-remove-btn { background: transparent; border: none; color: rgba(var(--color-foreground), 0.5); font-size: 12px; cursor: pointer; padding: 0; text-decoration: none; transition: color 0.2s; }
.text-remove-btn:hover { color: rgb(var(--color-foreground)); text-decoration: underline; }
.WI_complete_look { border: 1px solid rgba(var(--color-foreground), 0.08); margin-top: 24px; border-radius: 0; overflow: hidden; }
.WI_complete_look_header { background-color: rgb(var(--color-foreground)); padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
.WI_complete_look_header span { font-size: 12px; font-weight: 600; letter-spacing: 1.5px; color: rgb(var(--color-background)); }
.WI_complete_look_toggle { font-size: 16px; font-weight: bold; display: flex; align-items: center; color: rgb(var(--color-background)); transition: transform 0.3s; user-select: none; }
.WI_complete_look.open .WI_complete_look_toggle { transform: rotate(45deg); }
.WI_complete_look_body { padding: 16px; display: none; background: rgb(var(--color-background)); border-top: 1px solid rgba(var(--color-foreground), 0.08); }
.WI_complete_look.open .WI_complete_look_body { display: block; }
.WI_complete_look_product { display: flex; gap: 16px; }
.WI_complete_look_img { width: 70px; height: 90px; flex-shrink: 0; background: rgba(var(--color-foreground), 0.04); }
.WI_complete_look_img img { width: 100%; height: 100%; object-fit: cover; }
.WI_complete_look_info { flex: 1; display: flex; flex-direction: column; gap: 8px; }
.WI_complete_look_info_top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
.WI_complete_look_title { font-size: 13px; font-weight: 500; color: rgb(var(--color-foreground)); line-height: 1.3; }
.WI_complete_look_price { font-size: 13px; font-weight: 600; color: rgb(var(--color-foreground)); white-space: nowrap; }
.WI_complete_look_options { display: flex; flex-direction: column; gap: 4px; }
.WI_complete_look_option_group { display: flex; flex-direction: column; gap: 4px; }
.WI_complete_look_option_label { font-size: 12px; color: rgba(var(--color-foreground), 0.5); }
.WI_complete_look_option_values { display: flex; gap: 6px; flex-wrap: wrap; }
.WI_complete_look_option_val { border: 1px solid rgba(var(--color-foreground), 0.2); background: rgb(var(--color-background)); padding: 5px 12px; min-width: 35px; text-align: center; font-size: 12px; font-weight: 500; cursor: pointer; color: rgb(var(--color-foreground)); transition: all 0.2s; }
.WI_complete_look_option_val:hover { border-color: rgb(var(--color-foreground)); }
.WI_complete_look_option_val.selected { border-color: rgb(var(--color-foreground)); background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); }
.WI_complete_look_add_btn { background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); font-size: 12px; font-weight: 700; letter-spacing: 1.5px; border: none; height: 36px; padding: 0 24px; cursor: pointer; text-transform: uppercase; margin-top: 10px; display: inline-flex; align-items: center; justify-content: center; align-self: flex-start; transition: background 0.2s; }
.WI_complete_look_add_btn:hover { background: rgba(var(--color-foreground), 0.85); }
.WI_also_like { margin-top: 28px; padding-top: 24px; border-top: 1px solid rgba(var(--color-foreground), 0.08); }
.WI_also_like_header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.WI_also_like_header span { font-size: 12px; font-weight: 600; letter-spacing: 1.5px; color: rgb(var(--color-foreground)); }
.WI_also_like_nav { display: flex; gap: 6px; }
.WI_also_like_prev, .WI_also_like_next { border: none; background: transparent; cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; color: rgba(var(--color-foreground), 0.5); transition: color 0.2s; }
.WI_also_like_prev:hover, .WI_also_like_next:hover { color: rgb(var(--color-foreground)); }
.WI_also_like_body { width: 100%; overflow: hidden; }
.WI_also_like_list { display: flex; gap: 12px; overflow-x: auto; scroll-behavior: smooth; -ms-overflow-style: none; scrollbar-width: none; }
.WI_also_like_list::-webkit-scrollbar { display: none; }
.WI_also_like_item { flex: 0 0 160px; display: flex; flex-direction: column; gap: 6px; }
.WI_also_like_item_img { width: 160px; height: 180px; background-color: rgba(var(--color-foreground), 0.04); overflow: hidden; position: relative; }
.WI_also_like_item_img img { width: 100%; height: 100%; object-fit: cover; }
.WI_also_like_item_title { font-size: 12px; font-weight: 400; color: rgb(var(--color-foreground)); text-decoration: none; line-height: 1.35; margin-top: 2px; }
.WI_also_like_item_price { font-size: 12px; color: rgba(var(--color-foreground), 0.55); }
.WI_bundle_promo { background-color: rgba(var(--color-foreground), 0.05); padding: 16px; margin-top: 28px; border-radius: 0; }
.WI_bundle_promo_title { font-size: 12px; font-weight: 700; color: rgb(var(--color-foreground)); margin: 0 0 6px 0; letter-spacing: 1px; }
.WI_bundle_promo_desc { font-size: 12px; color: rgba(var(--color-foreground), 0.75); margin: 0; line-height: 1.45; }
.WI_bundle_promo_desc a { color: rgb(var(--color-foreground)); text-decoration: underline; font-weight: 600; }
.WI_discount_wrap { display: flex; align-items: center; gap: 12px; margin-top: 24px; padding-bottom: 24px; }
.WI_discount_input { flex: 1; border: none; border-bottom: 1.5px solid rgba(var(--color-foreground), 0.2); padding: 8px 0; font-size: 13px; outline: none; background: transparent; color: rgb(var(--color-foreground)); transition: border-color 0.2s; }
.WI_discount_input:focus { border-color: rgb(var(--color-foreground)); }
.WI_discount_btn { border: 1px solid rgb(var(--color-foreground)); background: rgb(var(--color-background)); color: rgb(var(--color-foreground)); padding: 8px 16px; font-size: 11px; font-weight: 600; cursor: pointer; letter-spacing: 1px; transition: all 0.2s; }
.WI_discount_btn:hover { border-color: rgb(var(--color-foreground)); background: rgba(var(--color-foreground), 0.04); }
.WI_cartLoading { width: 100%; height: 2px; position: absolute; bottom: 0; overflow: hidden; }
.WI_cartLoadingin { width: 100%; height: 2px; background-color: rgba(var(--color-foreground), 0.08); position: relative; display: none; }
.WI_cartLoadingActive { display: block; }
.WI_cartLoadingActive:before { content: ""; position: absolute; top: 0; left: -50%; height: 2px; width: 40%; background-color: rgb(var(--color-foreground)); animation: lineAnim 1s linear infinite; }
@keyframes lineAnim { 0% { left: -40%; } 50% { left: 20%; width: 80%; } 100% { left: 100%; width: 100%; } }
.WI_cartDrawerin_cart_footer { width: 100%; padding: 16px 24px; border-top: 1px solid rgba(var(--color-foreground), 0.08); background-color: rgb(var(--color-background)); z-index: 10; flex-shrink: 0; }
.WI_cartDrawer_total { width: 100%; display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.WI_cartDrawer_total h5 { margin: 0; font-size: 13px; color: rgb(var(--color-foreground)); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
.WI_cartDrawer_total h5.WI_cartDrawer_total_price { font-size: 16px; font-weight: 700; }
.WI_cartDrawer_checkout { width: 100%; height: 48px; background-color: rgb(var(--color-foreground)) !important; color: rgb(var(--color-background)) !important; border: none; font-size: 13px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background-color 0.2s; }
.WI_cartDrawer_checkout:hover { background-color: rgba(var(--color-foreground), 0.85) !important; }
.WI_cartDrawer_badges { display: flex; justify-content: center; align-items: center; gap: 8px; margin-bottom: 12px; padding: 0; list-style: none; }
.WI_cartDrawer_badges li { display: flex; align-items: center; }
.WI_cartDrawer_badges svg, .WI_cartDrawer_badges img { height: 20px; width: 32px; object-fit: contain; }
.WI_cartDrawer_subtext { font-size: 11px; color: rgba(var(--color-foreground), 0.55); text-align: center; margin: 0; line-height: 1.4; }
wi-cartdrawer .WI_cartDrawerin_cart_header, wi-cartdrawer .WI_cartDrawer_item, wi-cartdrawer .WI_complete_look, wi-cartdrawer .WI_also_like, wi-cartdrawer .WI_bundle_promo, wi-cartdrawer .WI_discount_wrap, wi-cartdrawer .WI_cartDrawerin_cart_footer { opacity: 0; transform: translateX(-40px); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease; }
wi-cartdrawer.active .WI_cartDrawerin_cart_header, wi-cartdrawer.active .WI_cartDrawer_item, wi-cartdrawer.active .WI_complete_look, wi-cartdrawer.active .WI_also_like, wi-cartdrawer.active .WI_bundle_promo, wi-cartdrawer.active .WI_discount_wrap, wi-cartdrawer.active .WI_cartDrawerin_cart_footer { opacity: 1; transform: translateX(0); }
wi-cartdrawer.active .WI_cartDrawerin_cart_header { transition-delay: 0.1s; }
wi-cartdrawer.active .WI_cartDrawer_item:nth-child(1) { transition-delay: 0.15s; }
wi-cartdrawer.active .WI_cartDrawer_item:nth-child(2) { transition-delay: 0.2s; }
wi-cartdrawer.active .WI_cartDrawer_item:nth-child(3) { transition-delay: 0.25s; }
wi-cartdrawer.active .WI_cartDrawer_item:nth-child(4) { transition-delay: 0.3s; }
wi-cartdrawer.active .WI_cartDrawer_item:nth-child(n+5) { transition-delay: 0.35s; }
wi-cartdrawer.active .WI_complete_look { transition-delay: 0.35s; }
wi-cartdrawer.active .WI_also_like { transition-delay: 0.4s; }
wi-cartdrawer.active .WI_bundle_promo { transition-delay: 0.45s; }
wi-cartdrawer.active .WI_discount_wrap { transition-delay: 0.5s; }
wi-cartdrawer.active .WI_cartDrawerin_cart_footer { transition-delay: 0.25s; }
wi-cartdrawer:not(.active) .WI_cartDrawerin_cart_header, wi-cartdrawer:not(.active) .WI_cartDrawer_item, wi-cartdrawer:not(.active) .WI_complete_look, wi-cartdrawer:not(.active) .WI_also_like, wi-cartdrawer:not(.active) .WI_bundle_promo, wi-cartdrawer:not(.active) .WI_discount_wrap, wi-cartdrawer:not(.active) .WI_cartDrawerin_cart_footer { transition: none !important; }

@media screen and (max-width: 800px) {
  .WI_cartDrawerin_cart { width: calc(100vw - 30px); height: 100dvh; }
  .WI_cartDrawerin_cart_footer { padding-bottom: max(16px, env(safe-area-inset-bottom)); }
}
</style>

<wi-cartdrawer>
    <div class="WI_cartDrawerin">
        <div class="WI_cartDrawerin_cart">
            <data-cart-count hidden>{{ cart.item_count }}</data-cart-count>
            <div class="WI_cartDrawerin_cart_header">
                <h2 class="WI_cartDrawerin_cart_headerH">
                  <div class="WI_cartDrawerin_cart_header_left">
                    <span class="WI_cartDrawer_bag_icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="19" height="20" viewBox="0 0 19 20" fill="none">
                        <mask id="mask0_288_159" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="1" y="1" width="17" height="17">
                          <path d="M17.2464 1.65829H1.32682V17.5779H17.2464V1.65829Z" fill="white"/>
                        </mask>
                        <g mask="url(#mask0_288_159)">
                          <path d="M14.5931 5.37195H3.98002V16.4493H14.5931V5.37195Z" stroke="#000" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M7.62828 7.03128V3.64837C7.62828 3.18405 8.02627 2.78606 8.49059 2.78606H10.2152C10.6795 2.78606 11.0775 3.18405 11.0775 3.64837V7.09761" stroke="#000" stroke-width="1.2" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                        </g>
                      </svg>
                    </span>
                    <span class="WI_cartDrawer_count">{{ 'sections.header.cart_count' | t: count: cart.item_count | upcase }}</span>
                  </div>
                  <span class="WI_cartDrawerCls">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </span>
                </h2>
                {% render 'free-shipping' %}
            </div>
            <div class="WI_loadingCartItemBlock">
              <div class="WI_loadingCartItemBlock_in">
                <div class="WI_cartLoading_eBox">
                  <div class="WI_cartLoadingin_eBox WI_cartLoadingActive_eBox"></div>
                </div>
              </div>
            </div>
            
            {% if cart.item_count > 0 %}
            <div class="WI_cartDrawerin_cart_body">
                {% form 'cart', cart %}
                <div class="WI_cartDrawerin_cart_form_in">
                    <div class="WI_cartDrawerin_cart_items">
                        {% for item in cart.items %}
                        <div class="WI_cartDrawer_item" data-itemKey="{{item.key}}" 
                        data-savingPrice="{%- if item.variant.compare_at_price -%}{{ item.variant.compare_at_price | minus: item.variant.price | times: item.quantity }}{%- endif -%}">
                            <div class="WI_cartDrawer_item_img">
                                <a href="{{ item.product.url }}">{{item.image | image_url: width: 250 | image_tag: loading: 'eager'}}</a>
                            </div>
                            <div class="WI_cartDrawer_item_info">
                                <div class="WI_cartDrawer_item_info_top">
                                    <a href="{{ item.product.url }}" class="WI_cartDrawer_item_title">{{item.product.title | escape}}</a>
                                    <span class="WI_cartDrawer_item_price">
                                        {%- if item.variant.compare_at_price > item.variant.price -%}
                                        <span class="compare-price">{{item.variant.compare_at_price | money}}</span>
                                        <span>{{item.variant.price | money}}</span>
                                        {%- else -%}
                                        <span>{{item.variant.price | money}}</span>
                                        {%- endif -%}
                                    </span>
                                </div>
                                
                                {%- if item.product.has_only_default_variant == false or item.properties.size > 0 -%}
                                    <div class="WI_cartDrawer_item_options">
                                        {%- if item.product.has_only_default_variant == false -%}
                                            {%- for option in item.options_with_values -%}
                                                <span class="option-tag">{{ option.name }}: {{ option.value }}</span>
                                            {%- endfor -%}
                                        {%- endif -%}
                                        {%- assign property_size = item.properties | size -%}
                                        {%- if property_size > 0 -%}
                                            {%- for p in item.properties -%}
                                                {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
                                                {%- unless p.last == blank or first_character_in_key == '_' -%}
                                                    <span class="option-tag">
                                                        <strong>{{ p.first }}:</strong>
                                                         {%- if p.last contains '/uploads/' -%}
                                                             <a href="{{ p.last }}" target="_blank">{{ p.last | split: '/' | last }}</a>
                                                        {%- else -%}
                                                            {{ p.last }}
                                                        {%- endif -%}
                                                    </span>
                                                {%- endunless -%}
                                            {%- endfor -%}
                                        {%- endif -%}
                                    </div>
                                {%- endif -%}
                                
                                <div class="WI_cartDrawer_item_info_bottom">
                                    <div class="WI_cartDrawer_quantity">
                                        <button type="button" class="WI_cartDrawer_minus">
                                          <svg class="WI_cartDrawer_minus" width="10" height="2" viewBox="0 0 10 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path class="WI_cartDrawer_minus" d="M0 1H10" stroke="currentColor" stroke-width="1.5"/>
                                          </svg>
                                        </button>
                                        <input value="{{ item.quantity }}" type="number" readonly />
                                        <button type="button" class="WI_cartDrawer_plus">
                                          <svg class="WI_cartDrawer_plus" width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path class="WI_cartDrawer_plus" d="M5 0V10M0 5H10" stroke="currentColor" stroke-width="1.5"/>
                                          </svg>
                                        </button>
                                    </div>
                                     <button type="button" class="cartDrawerRemove text-remove-btn">{{ 'sections.cart.remove_title' | t: title: '' | strip }}</button>
                                </div>
                            </div>
                            <div class="WI_cartLoading">
                                <div class="WI_cartLoadingin"></div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                    {% comment %} Dynamic Recommendations logic for Complete the Look & You May Also Like {% endcomment %}
                    {% assign exclusion_list = "" %}
                    {% for item in cart.items %}
                      {% assign exclusion_list = exclusion_list | append: item.product.handle | append: "," %}
                    {% endfor %}

                    {% assign recommended_products = "" %}
                    {% for item in cart.items %}
                      {% for col in item.product.collections %}
                        {% unless col.handle == 'all' or col.handle == 'frontpage' %}
                          {% for prod in col.products %}
                            {% unless exclusion_list contains prod.handle %}
                              {% if prod.available %}
                                {% assign recommended_products = recommended_products | append: prod.handle | append: "," %}
                                {% assign exclusion_list = exclusion_list | append: prod.handle | append: "," %}
                              {% endif %}
                            {% endunless %}
                          {% endfor %}
                        {% endunless %}
                      {% endfor %}
                    {% endfor %}

                    {% comment %} Fallback to filling recommendations with general catalog products if needed {% endcomment %}
                    {% assign rec_array = recommended_products | split: "," %}
                    {% if rec_array.size < 6 %}
                      {% for prod in collections['all'].products %}
                        {% unless exclusion_list contains prod.handle %}
                          {% if prod.available %}
                            {% assign recommended_products = recommended_products | append: prod.handle | append: "," %}
                            {% assign exclusion_list = exclusion_list | append: prod.handle | append: "," %}
                          {% endif %}
                        {% endunless %}
                        {% assign temp_array = recommended_products | split: "," %}
                        {% if temp_array.size >= 7 %}{% break %}{% endif %}
                      {% endfor %}
                    {% endif %}

                    {% assign rec_handles = recommended_products | split: "," %}
                    
                    {% comment %} COMPLETE THE LOOK (Product 1) {% endcomment %}
                    {% if rec_handles.size > 0 %}
                      {% assign first_rec_handle = rec_handles[0] %}
                      {% assign first_product = all_products[first_rec_handle] %}
                      {% if first_product.handle != blank %}
                        <div class="WI_complete_look open">
                          <div class="WI_complete_look_header" onclick="this.closest('.WI_complete_look').classList.toggle('open')">
                            <span>{{ section.settings.complete_look_title | default: 'FULLFØR LOOKEN' }}</span>
                            <span class="WI_complete_look_toggle"><svg xmlns="http://www.w3.org/2000/svg" class="icon-cancel" width="9" height="9" viewBox="0 0 9 9" fill="none">
    <path d="M0.5 8.5L4.5 4.5L0.5 8.5ZM8.5 0.5L4.49924 4.5L8.5 0.5ZM4.49924 4.5L0.5 0.5L4.49924 4.5ZM4.5 4.5L8.5 8.5L4.5 4.5Z" fill="#0B0B0B"></path>
    <path d="M0.5 8.5L4.5 4.5L8.5 8.5M8.5 0.5L4.49924 4.5L0.5 0.5" stroke="#0B0B0B" stroke-linecap="round" stroke-linejoin="round"></path>
</svg></span>
                          </div>
                          <div class="WI_complete_look_body">
                            <div class="WI_complete_look_product">
                              <div class="WI_complete_look_img">
                                <img src="{{ first_product.featured_image | image_url: width: 150 }}" alt="{{ first_product.title | escape }}">
                              </div>
                              <div class="WI_complete_look_info">
                                <div class="WI_complete_look_info_top">
                                  <span class="WI_complete_look_title">{{ first_product.title }}</span>
                                  <span class="WI_complete_look_price">{{ first_product.price | money }}</span>
                                </div>
                                
                                <div class="WI_complete_look_options">
                                  {%- unless first_product.has_only_default_variant -%}
                                    {%- for option in first_product.options_with_values -%}
                                      <div class="WI_complete_look_option_group">
                                        <span class="WI_complete_look_option_label">{{ option.name }}:</span>
                                        <div class="WI_complete_look_option_values">
                                          {%- for value in option.values -%}
                                            <button type="button" class="WI_complete_look_option_val {% if forloop.first %}selected{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
                                          {%- endfor -%}
                                        </div>
                                      </div>
                                    {%- endfor -%}
                                  {%- endunless -%}
                                </div>

                                <div class="WI_complete_look_form">
                                  {% if first_product.variants.size == 1 %}
                                    <input type="hidden" name="id" value="{{ first_product.variants[0].id }}">
                                  {% else %}
                                    <input type="hidden" name="id" class="WI_complete_look_variant_id" value="{{ first_product.variants[0].id }}">
                                    <select name="id" class="WI_complete_look_variant_select" style="display:none;">
                                      {% for variant in first_product.variants %}
                                        <option value="{{ variant.id }}" data-options="{{ variant.options | join: ',' }}">{{ variant.title }}</option>
                                      {% endfor %}
                                    </select>
                                  {% endif %}
                                  <button type="button" class="WI_complete_look_add_btn">{{ section.settings.complete_look_add_btn_text | default: '+ LEGG TIL' }}</button>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      {% endif %}
                    {% endif %}

                    {% comment %} YOU MAY ALSO LIKE (Products 2+) {% endcomment %}
                    {% if rec_handles.size > 1 %}
                      <div class="WI_also_like">
                        <div class="WI_also_like_header">
                          <span>{{ section.settings.you_may_also_like_title | default: 'DU LIKER KANSKJE OGSÅ' }}</span>
                          <div class="WI_also_like_nav">
                            <button type="button" class="WI_also_like_prev">
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="15 18 9 12 15 6"></polyline>
                              </svg>
                            </button>
                            <button type="button" class="WI_also_like_next">
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"></polyline>
                              </svg>
                            </button>
                          </div>
                        </div>
                        <div class="WI_also_like_body">
                          <div class="WI_also_like_list">
                            {% for handle in rec_handles offset: 1 limit: 6 %}
                              {% assign prod = all_products[handle] %}
                              {% if prod.handle != blank %}
                                <div class="WI_also_like_item">
                                  <div class="WI_also_like_item_img">
                                    <a href="{{ prod.url }}">
                                      <img src="{{ prod.featured_image | image_url: width: 250 }}" alt="{{ prod.title | escape }}">
                                    </a>
                                  </div>
                                  <a href="{{ prod.url }}" class="WI_also_like_item_title">{{ prod.title }}</a>
                                  <span class="WI_also_like_item_price">{{ prod.price | money }}</span>
                                </div>
                              {% endif %}
                            {% endfor %}
                          </div>
                        </div>
                      </div>
                    {% endif %}

                    {% comment %} EXERCERE BUNDLE promo box {% endcomment %}
                    <div class="WI_bundle_promo">
                      <h4 class="WI_bundle_promo_title">{{ section.settings.bundle_title | default: 'EXERCERE PAKKE' }}</h4>
                      <div class="WI_bundle_promo_desc">
                        {{ section.settings.bundle_desc | default: '<p>Spar 15 % ved kjøp av en pakke. Bare legg til en <a href="/collections/tops">Topp</a>, <a href="/collections/blouses">Bluse</a> og <a href="/collections/bottoms">Underdel</a> i handlekurven. Allerede nedsatte varer er ekskludert.</p>' }}
                      </div>
                    </div>

                    {% comment %} Discount Code Input {% endcomment %}
                    <div class="WI_discount_wrap">
                      <input type="text" name="discount" class="WI_discount_input" placeholder="{{ section.settings.discount_placeholder | default: 'Skriv inn rabattkode' }}" autocomplete="off">
                      <button type="button" class="WI_discount_btn" data-applied-text="{{ section.settings.discount_applied_btn_text | default: 'BRUKT' }}">{{ section.settings.discount_btn_text | default: 'BRUK' }}</button>
                    </div>

                </div>
                
                <div class="WI_cartDrawerin_cart_footer">
                    <div class="WI_cartDrawer_total">
                        <h5>{{ 'sections.cart.estimated_total' | t }}</h5>
                        <h5 class="WI_cartDrawer_total_price">{{ cart.total_price | money }}</h5>
                    </div>

                    <button type="submit" name="checkout" value="Checkout" class="WI_cartDrawer_checkout">{{ section.settings.checkout_btn_text | default: 'GÅ TIL KASSEN' }}</button>
                    
                    <ul class="WI_cartDrawer_badges">
                      <!-- Apple Pay -->
                     {% render 'Payments' %}
                    </ul>
                    <p class="WI_cartDrawer_subtext">
                      {%- if cart.duties_included and cart.taxes_included -%}
                        {%- if shop.shipping_policy.body == blank -%}
                          {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                        {%- else -%}
                          {{
                            'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                            | t: link: shop.shipping_policy.url
                          }}
                        {%- endif -%}
                      {%- elsif cart.duties_included == false and cart.taxes_included -%}
                        {%- if shop.shipping_policy.body == blank -%}
                          {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                        {%- else -%}
                          {{
                            'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                            | t: link: shop.shipping_policy.url
                          }}
                        {%- endif -%}
                      {%- elsif cart.duties_included and cart.taxes_included == false -%}
                        {%- if shop.shipping_policy.body == blank -%}
                          {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                        {%- else -%}
                          {{
                            'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                            | t: link: shop.shipping_policy.url
                          }}
                        {%- endif -%}
                      {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
                        {%- if shop.shipping_policy.body == blank -%}
                          {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                        {%- else -%}
                          {{
                            'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                            | t: link: shop.shipping_policy.url
                          }}
                        {%- endif -%}
                      {%- endif -%}
                    </p>
                </div>
                {% endform %}
            </div>
            {%- else -%}
              <div class="WI_cartDrawerin_cart_empty">
                <div class="WI_cartDrawerin_cart_empty_svg">
                  <svg width="56" viewBox="0 0 65 74" xmlns="http://www.w3.org/2000/svg"><g fill-rule="nonzero" fill="none"><path d="M64.407 9.856L53.605 0H11.371L.569 9.856A1.548 1.548 0 00.1 11.603c.235.619.843 1.031 1.524 1.031h61.727a1.62 1.62 0 001.522-1.031 1.545 1.545 0 00-.467-1.747z" fill="#C4C4C4"></path><path d="M63.351 9.927H1.624C.728 9.927 0 10.644 0 11.529v59.267C0 72.566 1.454 74 3.249 74h58.478c1.795 0 3.249-1.434 3.249-3.204V11.53c0-.885-.728-1.602-1.625-1.602z" fill="#E4E4E4"></path><path d="M32.488 45.122c-7.963 0-14.44-6.447-14.44-14.37v-4.79a1.6 1.6 0 011.605-1.596 1.6 1.6 0 011.604 1.596v4.79c0 6.163 5.04 11.177 11.23 11.177 6.192 0 11.231-5.014 11.231-11.177v-4.79a1.6 1.6 0 011.604-1.596 1.6 1.6 0 011.605 1.596v4.79c0 7.923-6.477 14.37-14.44 14.37z" fill="#6D6D6D"></path></g></svg>
                  <p>{{ 'general.cart.empty' | t }}</p>
                </div>
              </div>
            {% endif %}
        </div>
    </div>
</wi-cartdrawer>


{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "text",
      "id": "complete_look_title",
      "label": "Complete the Look Title",
      "default": "FULLFØR LOOKEN"
    },
    {
      "type": "text",
      "id": "complete_look_add_btn_text",
      "label": "Complete the Look Add Button Text",
      "default": "+ LEGG TIL"
    },
    {
      "type": "text",
      "id": "you_may_also_like_title",
      "label": "You May Also Like Title",
      "default": "DU LIKER KANSKJE OGSÅ"
    },
    {
      "type": "text",
      "id": "bundle_title",
      "label": "Bundle Title",
      "default": "EXERCERE PAKKE"
    },
    {
      "type": "richtext",
      "id": "bundle_desc",
      "label": "Bundle Description",
      "default": "<p>Spar 15 % ved kjøp av en pakke. Bare legg til en <a href=\"/collections/tops\">Topp</a>, <a href=\"/collections/blouses\">Bluse</a> og <a href=\"/collections/bottoms\">Underdel</a> i handlekurven. Allerede nedsatte varer er ekskludert.</p>"
    },
    {
      "type": "text",
      "id": "discount_placeholder",
      "label": "Discount Input Placeholder",
      "default": "Skriv inn rabattkode"
    },
    {
      "type": "text",
      "id": "discount_btn_text",
      "label": "Discount Button Text",
      "default": "BRUK"
    },
    {
      "type": "text",
      "id": "discount_applied_btn_text",
      "label": "Discount Applied Button Text",
      "default": "BRUKT"
    },
    {
      "type": "text",
      "id": "checkout_btn_text",
      "label": "Checkout Button Text",
      "default": "GÅ TIL KASSEN"
    },
  ]
}
{% endschema %}