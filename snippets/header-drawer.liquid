<div class="country-aesthatc _mobile">
  <localization-form>
    {%- form 'localization', id: 'LocalizationForm-Mobile', class: 'localization-form' -%}
      
      <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
      <input type="hidden" name="language_code" value="{{ localization.language.iso_code }}">

      <div class="no-js-hidden localization-form">
        <div class="MA-language-selector">
          
          <input type="checkbox" class="MA-lang-opener" id="MA-lang-opener-mobile" hidden>
          
          <div class="MA-language-selected" tabindex="0">
            <label for="MA-lang-opener-mobile" class="ma-flex">
              {% if localization.language.iso_code == 'en' %}
                <img class="ma-flag" src="https://cdn.shopify.com/s/files/1/0082/0228/9219/files/Flag_of_the_United_States_svg.png?v=1765303150" alt="English">
                <span class="ma-label">USD $</span>
              {% else %}
                <img class="ma-flag" src="https://cdn.shopify.com/s/files/1/0082/0228/9219/files/Flag_of_Norway_svg.png?v=1765303113" alt="Norsk">
                <span class="ma-label">NOK kr</span>
              {% endif %}

              <span class="ma-arrow">
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </label>
          </div>

          <div class="MA-language-options">
            {%- for language in localization.available_languages -%}
              <a href="#" 
                 class="ma-option {% if language.iso_code == localization.language.iso_code %}active{% endif %}" 
                 data-language-code="{{ language.iso_code }}">
                 
                {%- if language.iso_code == 'nb' or language.iso_code == 'no' -%}
                   <img class="ma-flag" src="https://cdn.shopify.com/s/files/1/0082/0228/9219/files/Flag_of_Norway_svg.png?v=1765303113" alt="Norsk">
                   <span class="ddd">kr NOK</span>
                {%- elsif language.iso_code == 'en' -%}
                   <img class="ma-flag" src="https://cdn.shopify.com/s/files/1/0082/0228/9219/files/Flag_of_the_United_States_svg.png?v=1765303150" alt="English">
                   <span class="ddd">$ USD</span>
                {%- endif -%}
                
              </a>
            {%- endfor -%}
          </div>

        </div>
      </div>
    {%- endform -%}
  </localization-form>
</div>

<style>
  /* Basic Mobile Styles */
  .country-aesthatc._mobile {
    display: block; /* Ensure it takes width in drawer */
  }
  
  /* Make sure the options open nicely in mobile (optional tweak) */
  #MA-lang-opener-mobile:checked ~ .MA-language-options {
    display: block;
    position: absolute; /* Keeps popup behavior */
    bottom: 100%; /* Opens UPwards on mobile if at bottom */
    left: 0;
    background: #fff;
    border: 1px solid #e5e5e5;
    z-index: 100;
    min-width: 120px;
  }
  /* If you prefer it opening downwards, change bottom: 100% to top: 100% */
</style>
