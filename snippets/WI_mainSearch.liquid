<style>
 predictive-search{width: 92%;max-width: 1600px;max-height: 90vh;position: fixed;top: 50%;left: 50%;transform: translate(-50%, -50%);z-index: 10;background-color:#EAE5DF;display:none;opacity: 0;visibility: hidden;transition: 0.3s ease-out;box-shadow: 0 20px 60px rgba(0,0,0,0.3);overflow: hidden;}   
 .predictive-searchActive{opacity:1;visibility:visible;display:flex !important;flex-direction: column;}
 body.search-open{overflow: hidden;}
 body.search-open::before{content: '';position: fixed;top: 0;left: 0;width: 100%;height: 100%;background-color: rgba(0,0,0,0.5);z-index: 9;backdrop-filter: blur(8px);transition: 0.3s ease;}

 .WI_searchInput_main{width: 100%;height: auto;display: flex;justify-content: space-between;align-items: center;padding: 25px 50px 20px;flex-shrink: 0;background: #f8f8f8;}
 .WI_searchInput_in{height: auto;position: relative;max-width: 1600px;display: flex;align-items: center;flex: 1;margin: 0 20px;}
.WI_searchInput_in input {
    width: 100%;
    height: 52px;
    border: none;
    padding: 0 45px 0 24px;
    transition: all 0.2s ease;
    flex: 1;
    padding: 15px;
    font-size: 14px;
    border: none;
    color: #000000;
    font-weight: 400;
    box-sizing: border-box;
    outline: none;
    box-shadow: none;
    background: transparent;
    font-family: Inter;
    font-family: Neue Haas Grotesk Display Pro;
    font-weight: 500;
    font-size: 14px;
    line-height: 120%;
    min-width: 600px;
    border: 1px solid #000000;
    color: #545453;
}
 .WI_searchInput_in input::placeholder{font-size:14px;color: rgba(0,0,0,0.5);}
.WI_search_icon {
    position: absolute;
    right: 5px;
    background-color: rgba(255,255,255,0);
    border: none;
    padding: 10px;
    opacity: 1;
    top: 6px;
}
.WI_searchInput_main .logo,
.WI_searchInput_main .header__heading-logo-wrapper{
  display: flex;
}
.WI_searchInput_main .logo{
width: 12%}
 .WI_search_icon svg{width: 18px;height: 18px;}
 .WI_searchResult{width:100%;flex: 1;padding: 0 50px 40px;display: none;overflow-y: auto;}
 .WI_searchResult::-webkit-scrollbar{width: 8px;background-color: #f7f7f7;}
 .WI_searchResult::-webkit-scrollbar-thumb{width: 8px;background-color: #bbb;border-radius: 10px;}
 .WI_searchResult::-webkit-scrollbar-thumb:hover{background-color: #999;}
 #predictive-search-results{width: 100%;height: auto;}
 .WI_productResult_con{width: 100%;height: auto;display: grid;grid-template-columns: repeat(4, 1fr);gap: 25px;}
 .WI_suggResult_con{width: 100%;height: auto;padding-left:0px;justify-content: center;margin-bottom: 25px;}
 #predictive-search-products{font-size: 18px;display: flex;justify-content: space-between;align-items: center;margin-bottom:25px;}
 #predictive-search-products button{border: none;background-color: #000;color: #fff;font-size: 14px;border-radius: 12px;padding: 14px 28px;cursor: pointer;transition: 0.2s;}
 #predictive-search-products button:hover{background-color: #333;}
 .WI_productResult_product{width:100%;height:auto;min-width: 0;}
 .WI_productResult_con > *{min-width: 0;}
 .WI_suggResult_con h3{font-size: 18px;}
.WI_suggResult_con ul {
    padding: 0;
    margin: 0;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 15px;
}
 .WI_suggResult_con ul li{list-style: none;}
 .WI_suggResult_con ul li a{line-height: normal;display: block;text-decoration: underline;}
 .WI_suggResult_con ul p{font-size: 16px;color: #000;margin: 10px 0;}
.WI_searchUPsell {
    width: 100%;
    flex: 1;
    padding: 30px 50px 40px;
    overflow-y: auto;
}
.WI_searchUPsell::-webkit-scrollbar{width: 8px;background-color: #f7f7f7;}
.WI_searchUPsell::-webkit-scrollbar-thumb{width: 8px;background-color: #bbb;border-radius: 10px;}
.WI_searchUPsell::-webkit-scrollbar-thumb:hover{background-color: #999;}
  p.noSugg {
    white-space: nowrap;
}
 .WI_searchUPsell_con{width: 100%;height: auto;}
 .WI_searchUpsell_product{width: 100%;height: auto;display: flex;justify-content: flex-start;flex-wrap: wrap;gap: 25px;}
 .WI_searchUpsell_product h3{font-size: 12px;}
 .WI_searchUpsell_sugg{width: 100%;height: auto;display: flex;align-items: center;justify-content: flex-start;gap: 20px;margin-bottom: 30px;flex-wrap: wrap;}
.WI_searchUpsell_sugg h3 {
    font-weight: 500;
    font-size: 18px;
    line-height: 120%;
    letter-spacing: 2px;
    text-align: center;
    {% comment %} text-transform: uppercase; {% endcomment %}
    color: #545453;
    margin-bottom: 20px;
    white-space: nowrap;
    margin: 0px;
}
 .WI_searchUpsell_proResult{width: 100%;height: auto;display: grid;grid-template-columns: repeat(4, 1fr);gap: 25px;}
.WI_searchUpsell_suggResult {
    height: auto;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: flex-start;
    row-gap: 4px;
}
 .WI_searchUpsell_products{width: 100%;height: auto;min-width: 0;}
.WI_searchUpsell_suggResult a {
    color: rgb(102, 102, 102);
    font-size: 15px;
    line-height: 24px;
    text-decoration: underline;
    white-space: nowrap;
    transition: 0.2s;
}
.WI_searchUpsell_suggResult a:hover {
    color: rgb(0, 0, 0);
}
 .WI_searchClose{width: 100%;height: auto;top: 0;left: 0;display: flex;justify-content: space-between;align-items: center;padding: 25px 50px 20px;flex-shrink: 0;border-bottom: 1px solid #eaeaea;}
 .WI_searchClose h3{font-size: 16px;font-weight: 600;color: #666;}
 .searchCls{padding: 0;background: #f5f5f5;border: none;cursor: pointer;border-radius: 50%;width: 40px;height: 40px;display: flex;align-items: center;justify-content: center;transition: all 0.25s ease;}
 .searchCls:hover{transform: rotate(90deg);}
 .searchCls svg{width: 18px;height: 18px;transition: fill 0.25s ease;}
.saerchClear {
    padding: 0;
    position: absolute;
    right: 40px;
    background-color: rgba(255,255,255,0);
    opacity: 0.5;
    border: none;
    display: none;
    cursor: pointer;
    top: 12px;
}
  .saerchClear svg{
    width: 20px;
  }
 .saerchClear:hover{background-color: rgba(255,255,255,0);}
 input[type="search"]::-webkit-search-decoration,
input[type="search"]::-webkit-search-cancel-button,
input[type="search"]::-webkit-search-results-button,
input[type="search"]::-webkit-search-results-decoration { display: none;}
.suggMobile{display: none;}
.WI_searchUpsell_proResult .collection-listing{width:100%;display: contents;}
.WI_searchUpsell_proResult .collection-listing .product-list{display: contents;}
.WI_productResult_con .collection-listing{width:100%;display: contents;}
.WI_productResult_con .collection-listing .product-list{display: contents;}
.WI_searchUpsell_proResult .card-wrapper,
.WI_productResult_con .card-wrapper{width: 100%;min-width: 0;}
.WI_searchUpsell_proResult .card,
.WI_productResult_con .card{width: 100%;}
.WI_searchUpsell_proResult .card__inner,
.WI_productResult_con .card__inner{border: none !important;outline: none !important;box-shadow: none !important;}
.WI_searchUpsell_proResult .card__media,
.WI_productResult_con .card__media{border: none !important;outline: none !important;box-shadow: none !important;}
.WI_searchUpsell_proResult .media,
.WI_productResult_con .media{border: none !important;outline: none !important;background: transparent;box-shadow: none !important;}
.WI_searchUpsell_proResult img,
.WI_productResult_con img{border: none !important;outline: none !important;box-shadow: none !important;}
.WI_searchUpsell_proResult .card,
.WI_productResult_con .card{box-shadow: none !important;}
.WI_searchUpsell_proResult .card::before,
.WI_searchUpsell_proResult .card::after,
.WI_productResult_con .card::before,
.WI_productResult_con .card::after{display: none !important;}
.WI_searchUpsell_proResult .card:hover,
.WI_productResult_con .card:hover{box-shadow: none !important;border: none !important;}
.WI_searchUpsell_proResult .card__inner:hover,
.WI_productResult_con .card__inner:hover{box-shadow: none !important;border: none !important;}
.WI_searchUpsell_proResult a,
.WI_productResult_con a{text-decoration: none !important;}
.WI_searchUpsell_proResult .card-wrapper:hover .card__inner,
.WI_productResult_con .card-wrapper:hover .card__inner{box-shadow: none !important;border: none !important;}
.WI_searchUpsell_proResult .card__content,
.WI_productResult_con .card__content{border-top: none !important;padding-top: 0 !important;}
.WI_searchUpsell_proResult .card__information,
.WI_productResult_con .card__information{border-top: none !important;}
.WI_searchUpsell_proResult .card-information,
.WI_productResult_con .card-information{border-top: none !important;}
.WI_searchUpsell_proResult .card__badge,
.WI_productResult_con .card__badge{border: none !important;}
.WI_searchUpsell_proResult *:not(button),
.WI_productResult_con *:not(button){border-top: none !important;border-bottom: none !important;}
{% comment %} .WI_searchUpsell_proResult button,
.WI_productResult_con button,
.WI_searchUpsell_proResult .button,
.WI_productResult_con .button{
  border: 2px solid #000 !important;
  border-radius: 100px !important;
  transition: all 0.3s ease !important;
} {% endcomment %}
{% comment %} .WI_searchUpsell_proResult button:hover,
.WI_productResult_con button:hover,
.WI_searchUpsell_proResult .button:hover,
.WI_productResult_con .button:hover{
  background-color: #000 !important;
  color: #fff !important;
} {% endcomment %}
.WI_searchUpsell_proResult .quick-add__submit,
.WI_productResult_con .quick-add__submit{border-radius: 0 !important;border: none !important;}
.WI_searchUpsell_proResult .product-form__submit,
.WI_productResult_con .product-form__submit{border-radius: none !important;border: none !important;}
#predictive-search-products button {border: none;background-color: #000;color: #fff;font-size: 14px;border-radius: 12px;padding: 14px 25px;}
.WI_searchClose .text-base {
    font-weight: 500;
    font-size: 16px;
    line-height: 120%;
    letter-spacing: 2px;
    text-align: center;
    {% comment %} text-transform: uppercase; {% endcomment %}
    color: #545453;
    margin: 0px;
}
@media screen and (max-width: 1600px) {
  predictive-search{width: 95%;}
}
@media screen and (max-width: 1400px) {
  .WI_productResult_con{grid-template-columns: repeat(3, 1fr);gap: 20px;}
  .WI_searchUpsell_proResult{grid-template-columns: repeat(3, 1fr);gap: 20px;}
}
@media screen and (max-width: 1200px) {
  predictive-search{max-height: 90dvh;width: 92%;}
  .WI_searchUpsell_products{width: 100%;}
  .WI_productResult_product{width: 100%;}
  .WI_searchInput_main .logo{display:none;}
  .WI_productResult_con{grid-template-columns: repeat(2, 1fr);gap: 20px;}
  .WI_searchUpsell_proResult{grid-template-columns: repeat(2, 1fr);gap: 20px;}
  .WI_searchUPsell{padding: 25px 40px 35px;}
  .WI_searchResult{padding: 0 40px 35px;}
}
@media screen and (max-width: 800px) {
  predictive-search{max-height: 100dvh;width: 100%;}
  .WI_searchUPsell{padding: 20px 10px 30px;}
  .WI_searchResult{padding: 0 25px 30px;}
  .WI_searchUpsell_products{width: 100% !important;}
  .WI_productResult_product{width: 100% !important;}
  .WI_searchInput_main{padding: 15px 25px;}
  .WI_searchClose{padding: 20px 25px 12px;}
  .WI_searchInput_in, #Wi_searchFormId{width: 100%;}
  .WI_searchInput_in input{width:100%;min-width: 100%;height: 48px;font-size: 15px;}
  .WI_searchUpsell_product{width: 100%;}
  .WI_productResult_con{grid-template-columns: repeat(2, 1fr);gap: 15px;}
  .WI_searchUpsell_proResult{grid-template-columns: repeat(2, 1fr);gap: 15px;}
  .WI_searchUpsell_sugg{width: 100%;padding: 0;margin-bottom:20px;gap: 12px;}
  .WI_searchUpsell_suggResult a{font-size: 13px;}
  .WI_suggResult_con{width: 100%;padding: 0;margin-top: 0px;}
  .WI_searchResult .collection-listing{width: 100%;}
  .WI_searchUPsell::-webkit-scrollbar{width: 4px;}
  .WI_searchResult::-webkit-scrollbar{width: 4px;}
  .suggMobile{display: block; margin: 0;}
  .suggDesktop{display: none;}
  .WI_searchInput_in{margin: 0;}
  .searchCls{width: 36px;height: 36px;}
  .searchCls svg{width: 16px;height: 16px;}
}
  /* ***************css**************** */
  input#Search::placeholder {
        color: rgb(0, 0, 0);
    font-size: 16px;
    line-height: 32px;
}
 .Ma-icos-cart {
    display: flex;
    align-items: center;
    gap: 20px;
    width: 12%;
    justify-content: flex-end;
    padding-right: 12px;
}
  .WI_suggResult_con{
    display: flex;
    align-items: center;
    gap: 15px;
    justify-content: center;
    display: none;
  }
@media screen and (max-width: 800px) {
predictive-search .logo {
    display: none;
}
  predictive-search .Ma-icos-cart {
    display: none;
}
 .WI_suggResult_con{display: none;}
}
  #SDP_searchBtn{ margin-right:16px;}
  @media(max-width:767px){
    #SDP_searchBtn{ margin-right:0px;}
  }
</style>

<predictive-search>
  <div class="WI_searchClose page-width">
    <div class="m-search-popup--header">
      <h3 class="text-base">{{ settings.title }}</h3>
    </div>
    <button type="button" class="searchCls">
   <svg class="" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <div class="WI_searchInput_main page-width">
    <div class="logo" logotest="">
      <a href="{{ routes.root_url }}" class="link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(min-width: 750px) {{ settings.logo_width }}px, 50vw{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo',
                widths: widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <form action="{{ routes.search_url }}" id="Wi_searchFormId" method="get" role="search">
      <div class="WI_searchInput_in">
        <input
          id="Search"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          role="combobox"
          aria-expanded="false"
          aria-owns="predictive-search-results"
          aria-controls="predictive-search-results"
          aria-haspopup="listbox"
          aria-autocomplete="list"
        >
        <input name="options[prefix]" type="hidden" value="last">
        <button type="button" class="WI_search_icon"><svg xmlns="http://www.w3.org/2000/svg" width="17" height="19" viewBox="0 0 17 19" fill="none">
<path d="M16.822 16.9625L11.8078 11.6343C12.7746 10.4037 13.3575 8.82148 13.3575 7.09662C13.3575 3.18383 10.3613 0 6.67913 0C2.99618 0 0 3.18383 0 7.09662C0 11.0094 2.99618 14.1932 6.67836 14.1932C8.3009 14.1932 9.78994 13.5731 10.9486 12.5465L15.9628 17.8747C16.0812 18.0005 16.2367 18.0634 16.3923 18.0634C16.5479 18.0634 16.7035 18.0005 16.8218 17.8747C17.0594 17.6223 17.0595 17.2149 16.822 16.9625ZM1.21432 7.09662C1.21432 3.89504 3.66555 1.29029 6.67843 1.29029C9.69132 1.29029 12.1425 3.89504 12.1425 7.09662C12.1425 10.2982 9.69132 12.9029 6.67843 12.9029C3.66555 12.9029 1.21432 10.2982 1.21432 7.09662Z" fill="#3C3C3C"></path>
</svg></button>
        <button type="button" class="saerchClear"><svg class="" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
        <input type="submit" style="display:none !important;" value="submit">
      </div>
    </form>

    <div class="Ma-icos-cart">
      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {% if cart == empty %}
          <span class="svg-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="20" viewBox="0 0 19 20" fill="none">
<mask id="mask0_288_159" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="1" y="1" width="17" height="17">
<path d="M17.2464 1.65829H1.32682V17.5779H17.2464V1.65829Z" fill="white"/>
</mask>
<g mask="url(#mask0_288_159)">
<path d="M14.5931 5.37195H3.98002V16.4493H14.5931V5.37195Z" stroke="#3C3C3C" stroke-width="0.994974" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M7.62828 7.03128V3.64837C7.62828 3.18405 8.02627 2.78606 8.49059 2.78606H10.2152C10.6795 2.78606 11.0775 3.18405 11.0775 3.64837V7.09761" stroke="#3C3C3C" stroke-width="0.994974" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
</g>
</svg></span>
        {% else %}
          <span class="svg-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="20" viewBox="0 0 19 20" fill="none">
<mask id="mask0_288_159" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="1" y="1" width="17" height="17">
<path d="M17.2464 1.65829H1.32682V17.5779H17.2464V1.65829Z" fill="white"/>
</mask>
<g mask="url(#mask0_288_159)">
<path d="M14.5931 5.37195H3.98002V16.4493H14.5931V5.37195Z" stroke="#3C3C3C" stroke-width="0.994974" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M7.62828 7.03128V3.64837C7.62828 3.18405 8.02627 2.78606 8.49059 2.78606H10.2152C10.6795 2.78606 11.0775 3.18405 11.0775 3.64837V7.09761" stroke="#3C3C3C" stroke-width="0.994974" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
</g>
</svg></span>
        {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="WI_searchUPsell">
    <div class="WI_searchUPsell_con">
      <div class="WI_searchUpsell_sugg suggDesktop">
        <h3>{{settings.popular }}</h3>
        <div class="WI_searchUpsell_suggResult">
          {%- if settings.text_a != blank -%}
            <a href="{{settings.url_a}}">{{settings.text_a}}</a>
          {%- endif -%}
          {%- if settings.text_b != blank -%}
            <a href="{{settings.url_b}}">{{settings.text_b}}</a>
          {%- endif -%}
          {%- if settings.text_c != blank -%}
            <a href="{{settings.url_c}}">{{settings.text_c}}</a>
          {%- endif -%}
          {%- if settings.text_d != blank -%}
            <a href="{{settings.url_d}}">{{settings.text_d}}</a>
          {%- endif -%}
          {%- if settings.text_e != blank -%}
            <a href="{{settings.url_e}}">{{settings.text_e}}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="WI_searchUpsell_product">
        <div class="WI_searchUpsell_sugg suggMobile">
          <div class="WI_searchUpsell_suggResult">
            {%- if settings.text_a != blank -%}
              <a href="{{settings.url_a}}">{{settings.text_a}}</a>
            {%- endif -%}
            {%- if settings.text_b != blank -%}
              <a href="{{settings.url_b}}">{{settings.text_b}}</a>
            {%- endif -%}
            {%- if settings.text_c != blank -%}
              <a href="{{settings.url_c}}">{{settings.text_c}}</a>
            {%- endif -%}
            {%- if settings.text_d != blank -%}
              <a href="{{settings.url_d}}">{{settings.text_d}}</a>
            {%- endif -%}
            {%- if settings.text_e != blank -%}
              <a href="{{settings.url_e}}">{{settings.text_e}}</a>
            {%- endif -%}
          </div>
        </div>

        <div class="WI_searchUpsell_proResult">
          {%- liquid
            if true
              assign product_limit = 20
            else
              assign product_limit = section.settings.grid | times: section.settings.rows
            endif
          -%}
          {%- assign serProducts = settings.searchPro -%}
          <div class="collection-listing" data-cc-animate="cc-fade-in-up">
            <div class="product-list product-list--per-row-{{ section.settings.grid }} product-list--image-shape-{{ settings.prod_thumb_shape }} carousel">
              {% for product in serProducts %}
              <div class="WI_searchUpsell_products">
                {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'square',
                    image_shape: 'default',
                    show_secondary_image: true,
                    show_vendor: false,
                    show_rating: false,
                    lazy_load: false,
                    quick_add:  false,
                    section_id: section.id
                  %}
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="predictive-search" tabindex="-1" class="WI_searchResult"></div>
</predictive-search>


<script src="{{ 'WI_predictiveSearch.js' | asset_url }}" ></script>
<script>
  let mainSerch = document.querySelector('predictive-search');
  
  function openSearch() {
    mainSerch.style.display = "flex";
    document.body.classList.add('search-open');
      setTimeout(()=>{
        mainSerch.classList.add('predictive-searchActive');
        setTimeout(()=>{
          document.getElementById('Search').focus();
        },200);
      },10);
  }
  
  function closeSearch() {
    mainSerch.classList.remove('predictive-searchActive');
    document.body.classList.remove('search-open');
    setTimeout(() => {
      mainSerch.style.display = "none";
      document.getElementById('Search').value = '';
    },310);
  }
  
  document.querySelectorAll('.header__icon--search').forEach((searchBar)=>{
    searchBar.addEventListener('click', (e)=>{
      e.preventDefault();
      openSearch();
    });
  });
  
  document.querySelector('.searchCls').addEventListener('click', closeSearch);
  document.body.addEventListener('click', (e) => {
    if (document.body.classList.contains('search-open') && e.target === document.body) {
      closeSearch();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.body.classList.contains('search-open')) {
      closeSearch();
    }
  });

  function redirectToSearch() {
    const searchValue = document.getElementById('Search').value.trim();
    if (searchValue.length) {
      window.location.href = `/search?q=${encodeURIComponent(searchValue)}`;
    }
  }
</script>