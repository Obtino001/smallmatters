    font-weight: 500;
    font-size: 18px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #3c3c3c;
    margin: 0;
  }

  .sg-close {
    position: absolute;
    right: 30px;
    top: 18px;
    background: none;
    border: 0;
    cursor: pointer;
    width: 25px;
    height: 20px;
  }
  
  .sg-toggle-wrapper {
    position: absolute;
    right: 80px;
    top: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #3c3c3c;
    cursor: pointer;
  }

  .sg-body { padding: 24px; }
  .sg-meta p { margin: 0 0 8px; font-size: 13px; color: #3c3c3c; }
  .sg-table { overflow: hidden; margin-top: 18px; }
  
  .sg-row {
    display: flex;
    width: 100%;
  }
  
  .sg-row--head { background: #D9D9D9; font-weight: 500; font-size: 13px; }
  
