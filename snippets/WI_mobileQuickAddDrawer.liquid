        >
          <path d="M10.48 1.796 9.473.789 5.48 4.78 1.488.79.48 1.796l3.993 3.993L.48 9.78l1.008 1.008L5.48 6.796l3.993 3.993L10.48 9.78 6.488 5.79z" fill="#3C3C3C" fill-rule="nonzero"></path>
        </svg>
      </div>
    </div>
    <div class="WI_mobileQuickAffDrawer_pro" id="WI_mobileQuickAffDrawer_pro">
      <div class="WI_quickAddProduct_img"></div>
      <wi-quickaddproduct-info> </wi-quickaddproduct-info>
    </div>
  </div>
