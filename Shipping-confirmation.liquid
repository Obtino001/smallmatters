{% if fulfillment.item_count == item_count %} 
  {% capture email_title %}Bestillingen din er på vei{% endcapture %}
  {% capture email_body %}
    <p>Gode nyheter! Bestillingen din er på vei til deg{% if fulfillment.tracking_company %} med {{ fulfillment.tracking_company }}{% endif %}.</p>
    <p>Du kan enkelt følge pakken ved å bruke knappen nedenfor.</p>
    <p>Vi håper du blir kjempefornøyd med produktene dine. Skulle du ha noen spørsmål om bestillingen din, er du alltid hjertelig velkommen til å svare på denne e-posten.</p>
    
    <h3>Besøk oss gjerne i butikken vår</h3>
    <p>Du er også hjertelig velkommen innom butikken vår for å kjenne på materialene, prøve ulike modeller og få personlig hjelp. Vi setter stor pris på å møte kundene våre, enten det er for en hyggelig prat eller for å hjelpe deg med spørsmål.</p>
    
    <p style="margin-top:30px;">
    Varm hilsen,<br>
    <strong>Team Smallmatters</strong><br>
    Holmenveien 20, 0374 Oslo<br>
    Åpningstider: tir 11-16 og tor 11-18, eller etter avtale.
    </p>
  {% endcapture %}
{% elsif fulfillment.item_count > 1 %} 
  {% if fulfillment_status == 'fulfilled' %}
    {% capture email_title %}De siste varene i bestillingen din er på vei{% endcapture %}
    {% capture email_body %}<p>De siste varene i bestillingen din er på vei. Spor forsendelsen din for å se leveringsstatusen.</p>{% endcapture %}
  {% else %}
    {% capture email_title %}Noen av varene i bestillingen din er på vei{% endcapture %}
    {% capture email_body %}<p>Noen av varene i bestillingen din er på vei. Spor forsendelsen din for å se leveringsstatusen.</p>{% endcapture %}
  {% endif %}
{% else %} 
  {% if fulfillment_status == 'fulfilled' %}
    {% capture email_title %}Den siste varen i bestillingen din er på vei{% endcapture %}
    {% capture email_body %}<p>Den siste varen i bestillingen din er på vei. Spor forsendelsen din for å se leveringsstatusen.</p>{% endcapture %}
  {% else %}
    {% capture email_title %}En vare i bestillingen din er på vei{% endcapture %}
    {% capture email_body %}<p>En vare i bestillingen din er på vei. Spor forsendelsen din for å se leveringsstatusen.</p>{% endcapture %}
  {% endif %}
{% endif %}

{% capture email_emphasis %}Beregnet leveringsdato: <strong>{{fulfillment.estimated_delivery_at | date: format: 'date'}}</strong>{% endcapture %}

<!DOCTYPE html>
