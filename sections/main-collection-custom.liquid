{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

{%- endstyle -%}


  <style>
#ProductGridContainer #product-grid .grid__item:has(.promo-card) {
    width: calc(100% - var(--grid-desktop-horizontal-spacing) * 3 / 6);
    max-width: calc(100% - var(--grid-desktop-horizontal-spacing) * 3 / 6);
    flex-grow: 1;
}

#ProductGridContainer #product-grid .grid__item:has(.promo-card) ~ .grid__item:has(.promo-card) {
    display: none !important;
}
  </style>



<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }} {{ collection.title | replace: " ", '' }} container-x">
  <div class="collection-category-tabs-mob">
    {% render 'collection-category-tabs' %}
           <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} padding-with{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facet-exercer',
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type
          %}
        </aside>
  </div>
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort padding-with small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count'
                    | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical padding-with {% endif %}">
      {%- comment -%} Custom exercer filter assets are loaded inside the snippet {%- endcomment -%}
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper large-up-hide-none {% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} padding-with{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facet-exercer',
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty padding-with" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} padding-with{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {% assign skip_card_product_styles = false %}
              {%- liquid
                assign exr_active_sizes = ''
                for filter in collection.filters
                  assign filter_label_down = filter.label | downcase
                  if filter_label_down contains 'størrelse' or filter_label_down contains 'storrelse' or filter_label_down contains 'size'
                    for value in filter.active_values
                      if exr_active_sizes == ''
                        assign exr_active_sizes = value.label
                      else
                        assign exr_active_sizes = exr_active_sizes | append: '|' | append: value.label
                      endif
                    endfor
                  endif
                endfor
              -%}
              {%- for product in collection.products -%}
                {%- liquid
                  assign exr_show_card = true
                  if exr_active_sizes != ''
                    assign exr_show_card = false
                    assign exr_size_list = exr_active_sizes | split: '|'
                    for variant in product.variants
                      if variant.available
                        for exr_size in exr_size_list
                          if variant.option1 == exr_size or variant.option2 == exr_size or variant.option3 == exr_size
                            assign exr_show_card = true
                          endif
                        endfor
                      endif
                    endfor
                  endif
                -%}
                {%- unless exr_show_card -%}
                  {%- continue -%}
                {%- endunless -%}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                <li
                  class="grid__item  collection-grid-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                 {% render 'card-product-color-swatches',
                    show_swatches: true,
                    swatch_limit: 3,
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    lazy_load: false,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    section_id: section.id,
                    quick_add: section.settings.quick_add
                  %}
                </li>
                {% assign index = forloop.index %}
                {%- assign skip_card_product_styles = true -%}
                {% for block in section.blocks %}
                  {% if block.settings.insert_after == index %}
                    {% case block.type %}
                      {% when 'countdown_promo' %}
                        {% render 'card-countdown-promo', block: block %}
                      {% when 'trustpilot_promo' %}
                        {% render 'card-trustpilot-promo', block: block %}
                    {% endcase %}
                  {% endif %}
                {% endfor %}
              {%- endfor -%}
            </ul>

           {% if section.settings.infinite == 'infinite' %}
  <input type="hidden" id="total-pages" value="{{ paginate.pages }}">
  
  {% if section.settings.infinite_progressbar %}
    <input type="hidden" id="collection-total-count" value="{{ collection.all_products_count }}">
    <div class="collection-progress-wrapper">
      {% comment %} Text replaced with schema setting {% endcomment %}
      <p id="progress-text">{{ section.settings.infinite_progress_text  }}</p>
      <div class="progress-bar-bg">
        <div id="progress-bar-fill" style="width: 0%;"> </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.infinite_btn %}
    <div class="load-more-container">
      <button class="view-more-button btn button nx-btn"> 
        {% comment %} Text replaced with schema setting {% endcomment %}
        <span class="nx-btn-text">{{ section.settings.infinite_btn_text  }}</span>
      </button>
    </div>
  {% endif %}

  <div class="page-load-status">
    <div class="infinite-scroll-request">
      <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
      </svg>
    </div>
    {% comment %} Text replaced with schema setting {% endcomment %}
    <p class="infinite-scroll-last">{{ section.settings.infinite_finished_text }}</p>
    {% comment %} Text replaced with schema setting {% endcomment %}
    <p class="infinite-scroll-error">{{ section.settings.infinite_error_text  }}</p>
  </div>
{% endif %}
            
            {% comment %} {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%} {% endcomment %}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>
{% if section.settings.infinite == 'infinite' %}
{% comment %} Infinite Scroll logic is now handled natively in custom-filters.js via IntersectionObserver {% endcomment %}
{% endif %}
<style>
.page-load-status {
  text-align: center;
  margin-top: 30px;
  margin-bottom: 30px;
}
.load-more-container {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 30px;
}
.infinite-scroll-request,
.infinite-scroll-last,
.infinite-scroll-error {
  display: none;
}
.page-load-status .spinner {
  width: 20px;
  height: 20px;
  animation: rotate 1.4s linear infinite;
}
.infinite-scroll-request .view-more-button {
  display: none; 
}
.page-load-status .spinner .path {
  stroke: #000;
  stroke-dasharray: 187;
  stroke-dashoffset: 0;
  transform-origin: center;
  animation: dash 1.4s ease-in-out infinite;
}
@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(270deg); }
}
@keyframes dash {
  0% { stroke-dashoffset: 187; }
  50% { stroke-dashoffset: 46; transform: rotate(135deg); }
  100% { stroke-dashoffset: 187; transform: rotate(450deg); }
}

{% if section.settings.infinite_progressbar %}
 .collection-progress-wrapper {
  max-width: 400px;
  margin: 20px auto;
  text-align: center;
}
.progress-bar-bg {
  width: 100%;
  height: 6px;
  background-color: #e0e0e0;
  border-radius: 3px;
  overflow: hidden;
  margin-top: 10px;
}
#progress-bar-fill {
  height: 100%;
  background-color: #3c3c3c;
  transition: width 0.3s ease;
}
{% endif %}
</style>

{% endif %}
{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
{
  "type": "range",
  "id": "products_per_page",
  "min": 8,
  "max": 36,
  "step": 4,
  "default": 16,
  "label": "Products per page"
},
{
  "type": "range",
  "id": "columns_desktop",
  "min": 1,
  "max": 6,
  "step": 1,
  "default": 4,
  "label": "Desktop grid columns"
},
{
  "type": "color_scheme",
  "id": "color_scheme",
  "label": "Color scheme",
  "info": "Applies to product cards",
  "default": "scheme-1"
},
  {
      "type": "header",
      "content": "Infinite Scrolling"
    },
    {
  "type": "text",
  "id": "infinite_progress_text",
  "label": "Tekst for fremgangsfelt",
  "default": "Viser varer..."
},
{
  "type": "text",
  "id": "infinite_btn_text",
  "label": "Tekst for last mer-knapp",
  "default": "Last mer"
},
{
  "type": "text",
  "id": "infinite_finished_text",
  "label": "Tekst for ferdig lastet",
  "default": "Alle produkter er lastet inn"
},
{
  "type": "text",
  "id": "infinite_error_text",
  "label": "Tekst for ingen flere sider",
  "default": "Ingen flere sider å laste"
},
{
  "type": "text",
  "id": "infinite_showing_text",
  "label": "Tekst for 'Viser'",
  "default": "Viser"
},
{
  "type": "text",
  "id": "infinite_of_text",
  "label": "Tekst for 'av'",
  "default": "av"
},
{
  "type": "text",
  "id": "infinite_products_text",
  "label": "Tekst for 'produkter'",
  "default": "produkter"
},
    {
      "type": "select",
      "id": "infinite",
      "options": [
        {
          "label": "Pagination",
          "value": "pagination"
        },
        {
          "label": "Infinite",
          "value": "infinite"
        }
      ],
      "label": "Select",
      "default": "pagination"
    },
    {
      "type": "checkbox",
      "id": "infinite_btn",
      "label": "Load more button",
      "default": false,
      "visible_if": "{{ section.settings.infinite == 'infinite' }}"
    },
    {
      "type": "checkbox",
      "id": "infinite_progressbar",
      "label": "Progress bar",
      "default": false,
      "visible_if": "{{ section.settings.infinite == 'infinite' }}"
    },
{
  "type": "header",
  "content": "Product image settings"
},
{
  "type": "select",
  "id": "image_ratio",
  "options": [
    { "value": "adapt", "label": "Adapt to image" },
    { "value": "portrait", "label": "Portrait" },
    { "value": "square", "label": "Square" }
  ],
  "default": "adapt",
  "label": "Image ratio"
},
{
  "type": "select",
  "id": "image_shape",
  "options": [
    { "value": "default", "label": "Default" },
    { "value": "arch", "label": "Arch" },
    { "value": "blob", "label": "Blob" },
    { "value": "chevronleft", "label": "Chevron Left" },
    { "value": "chevronright", "label": "Chevron Right" },
    { "value": "diamond", "label": "Diamond" },
    { "value": "parallelogram", "label": "Parallelogram" },
    { "value": "round", "label": "Round" }
  ],
  "label": "Image shape",
  "info": "Controls how product images are clipped"
},
{
  "type": "checkbox",
  "id": "show_secondary_image",
  "default": false,
  "label": "Show secondary image on hover"
},
{
  "type": "checkbox",
  "id": "show_vendor",
  "default": false,
  "label": "Show vendor"
},
{
  "type": "checkbox",
  "id": "show_rating",
  "default": false,
  "label": "Show product rating",
  "info": "Requires a review app configured"
},
{
  "type": "select",
  "id": "quick_add",
  "default": "none",
  "label": "Quick add button",
  "info": "Choose how customers add products quickly",
  "options": [
    { "value": "none", "label": "None" },
    { "value": "standard", "label": "Standard" },
    { "value": "bulk", "label": "Bulk add" }
  ]
},
{
  "type": "header",
  "content": "Filtering & Sorting"
},
{
  "type": "checkbox",
  "id": "enable_filtering",
  "default": true,
  "label": "Enable filtering",
  "info": "Show filter sidebar or bar"
},
{
  "type": "select",
  "id": "filter_type",
  "options": [
    { "value": "horizontal", "label": "Horizontal bar" },
    { "value": "vertical", "label": "Left sidebar" },
    { "value": "drawer", "label": "Filter drawer" }
  ],
  "default": "horizontal",
  "label": "Filter layout"
},
{
  "type": "checkbox",
  "id": "enable_sorting",
  "default": true,
  "label": "Enable sorting options"
},
    {
      "type": "header",
      "content": "Mobile Content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
