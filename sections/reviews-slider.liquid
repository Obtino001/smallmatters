<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.swiper-container-{{ section.id }}', {
      slidesPerView: 1,  // Default: 1 slide (Matches your 100% mobile width)
      spaceBetween: 10,
      loop: false, 
      {% if section.settings.autoplay %}
      autoplay: {
        delay: {{ section.settings.autoplay_speed }},
        disableOnInteraction: false,
      },
      {% endif %}
      navigation: {
        nextEl: '#next-btn-{{ section.id }}',
        prevEl: '#prev-btn-{{ section.id }}',
      },
      breakpoints: {
        // Mobile (> 450px)
        450: {
          slidesPerView: 1.3, 
          spaceBetween: 10
        },
        // Tablet (> 750px)
        750: {
          slidesPerView: 2,
          spaceBetween: 10
        },
        // Desktop (> 990px)
        990: {
          slidesPerView: 3, // Matches your 25% desktop width
          spaceBetween: 10
        },
           1200: {
          slidesPerView: 4, // Matches your 25% desktop width
          spaceBetween: 10
        }
      }
    });
  });
</script>