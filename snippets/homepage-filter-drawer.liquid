{% comment %}
  Homepage fixed FILTER button + drawer.
  Categories + filters; Apply redirects to the filter collection page.
{% endcomment %}

{%- liquid
  assign home_filter_col = filter_collection | default: section.settings.filter_collection
  if home_filter_col == blank
    assign home_filter_col = collections.all
  endif
  if home_filter_col == blank
    for block in section.blocks
      if block.settings.collection != blank
        assign home_filter_col = block.settings.collection
        break
      endif
    endfor
  endif

  assign show_home_filter = false
  if section.settings.enable_home_filter and home_filter_col != blank
    assign show_home_filter = true
  endif
-%}

{%- if show_home_filter -%}

{{ 'custom-exercer.css' | asset_url | stylesheet_tag }}
{{ 'homepage-filter.css' | asset_url | stylesheet_tag }}
<script src="{{ 'homepage-filter.js' | asset_url }}" defer="defer"></script>

<home-filter-widget class="home-filter-widget">
  <button
    type="button"
    class="home-filter-fab"
    data-home-filter-open
    aria-label="{{ section.settings.home_filter_label | default: 'Filter' | escape }}"
  >
    <span class="home-filter-fab__text">{{ section.settings.home_filter_label | default: 'Filter' }}</span>
    <span class="home-filter-fab__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="17" viewBox="0 0 18 17" fill="none">
        <path d="M16.6875 8.18862H5.87688M2.061 8.18862H0.5M2.061 8.18862C2.061 7.68272 2.26197 7.19754 2.61969 6.83982C2.97742 6.48209 3.4626 6.28112 3.9685 6.28112C4.4744 6.28112 4.95958 6.48209 5.31731 6.83982C5.67503 7.19754 5.876 7.68272 5.876 8.18862C5.876 8.69453 5.67503 9.17971 5.31731 9.53743C4.95958 9.89516 4.4744 10.0961 3.9685 10.0961C3.4626 10.0961 2.97742 9.89516 2.61969 9.53743C2.26197 9.17971 2.061 8.69453 2.061 8.18862ZM16.6875 13.9698H11.658M11.658 13.9698C11.658 14.4758 11.4565 14.9615 11.0987 15.3193C10.7409 15.6771 10.2556 15.8781 9.74963 15.8781C9.24372 15.8781 8.75854 15.6763 8.40082 15.3186C8.04309 14.9608 7.84212 14.4757 7.84212 13.9698M11.658 13.9698C11.658 13.4637 11.4565 12.9789 11.0987 12.6211C10.7409 12.2633 10.2556 12.0622 9.74963 12.0622C9.24372 12.0622 8.75854 12.2632 8.40082 12.6209C8.04309 12.9787 7.84212 13.4638 7.84212 13.9698M7.84212 13.9698H0.5M16.6875 2.4075H13.9706M10.1548 2.4075H0.5M10.1548 2.4075C10.1548 1.9016 10.3557 1.41642 10.7134 1.05869C11.0712 0.700968 11.5563 0.5 12.0622 0.5C12.3127 0.5 12.5608 0.549339 12.7922 0.6452C13.0236 0.741061 13.2339 0.881566 13.4111 1.05869C13.5882 1.23582 13.7287 1.4461 13.8246 1.67753C13.9204 1.90896 13.9697 2.157 13.9697 2.4075C13.9697 2.658 13.9204 2.90604 13.8246 3.13747C13.7287 3.3689 13.5882 3.57918 13.4111 3.75631C13.2339 3.93343 13.0236 4.07394 12.7922 4.1698C12.5608 4.26566 12.3127 4.315 12.0622 4.315C11.5563 4.315 11.0712 4.11403 10.7134 3.75631C10.3557 3.39858 10.1548 2.9134 10.1548 2.4075Z" stroke="currentColor" stroke-miterlimit="10" stroke-linecap="round"/>
      </svg>
    </span>
  </button>

  <div class="exr-overlay home-filter-overlay" data-home-filter-overlay></div>

  <div class="exr-drawer home-filter-drawer" data-home-filter-drawer aria-label="Filters">
    <div class="exr-drawer__header">
      <div class="exr-drawer__header-left">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="10" viewBox="0 0 14 10" fill="none">
          <path d="M6.61111 8.33332H12.7222M0.5 1.66666H6.84188M9.94444 1.66666H12.7222M3.27778 8.33332H0.5" stroke="currentColor" stroke-linecap="round"/>
          <path d="M4.94482 7.06641C5.64413 7.06658 6.21125 7.63371 6.21143 8.33301C6.21143 9.03246 5.64424 9.59943 4.94482 9.59961C4.24526 9.59961 3.67822 9.03257 3.67822 8.33301C3.6784 7.6336 4.24537 7.06641 4.94482 7.06641ZM8.27783 0.400391C8.97739 0.400391 9.54443 0.967432 9.54443 1.66699C9.54426 2.3664 8.97728 2.93359 8.27783 2.93359C7.57838 2.93359 7.01141 2.3664 7.01123 1.66699C7.01123 0.967431 7.57827 0.400391 8.27783 0.400391Z" stroke="currentColor" stroke-width="0.8"/>
        </svg>
        <h3 class="exr-drawer__title">{{ section.settings.home_filter_drawer_title | default: 'Filter' }}</h3>
      </div>
      <button type="button" class="exr-drawer__close" data-home-filter-close aria-label="Close Filters">
        <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 9 9" fill="none">
          <path d="M0.5 8.5L4.5 4.5L8.5 8.5M8.5 0.5L4.49924 4.5L0.5 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <div class="exr-drawer__body">
      {%- paginate home_filter_col.products by 1 -%}
        {%- assign collection = home_filter_col -%}

        <details class="exr-group home-filter-categories-group" open>
          <summary class="exr-group__trigger">
            <span>{{ section.settings.home_filter_categories_label | default: 'KATEGORI' | escape }}</span>
            <span class="exr-group__arrow">
              <svg width="12" height="7" viewBox="0 0 12 7" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </summary>
          <div class="exr-group__body">
            {% render 'home-filter-categories', section: section, stock_param: false %}
          </div>
        </details>

        <form
          id="home-filter-form-{{ section.id }}"
          class="home-filter-form"
          action="{{ collection.url }}"
          method="get"
          data-home-filter-form
        >
          <input type="hidden" name="filter.v.availability" value="1">

          {%- if section.settings.enable_home_filter_sorting -%}
            <details class="exr-group" open>
              <summary class="exr-group__trigger">
                <span>{{ 'products.facets.sort_by_label' | t | default: 'SORTER' | upcase }}</span>
                <span class="exr-group__arrow">
                  <svg width="12" height="7" viewBox="0 0 12 7" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </summary>
              <div class="exr-group__body">
                <div class="exr-sort home-filter-sort">
                  {%- assign sort_by = collection.default_sort_by -%}
                  <select name="sort_by" class="exr-sort__select" aria-label="Sort by">
                    {%- for option in collection.sort_options -%}
                      <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="exr-sort__arrow">
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </div>
              </div>
            </details>
          {%- endif -%}

          {% render 'facet-exercer-fields' %}
        </form>
      {%- endpaginate -%}
    </div>

    <div class="exr-drawer__footer home-filter-drawer__footer">
      <button
        type="submit"
        form="home-filter-form-{{ section.id }}"
        class="button button--primary home-filter-apply"
      >
        {{ section.settings.home_filter_apply_label | default: 'Apply Filter' }}
      </button>
      <a href="{{ home_filter_col.url }}" class="button button--secondary home-filter-view-all">
        {{ section.settings.home_filter_view_all_label | default: 'View all products' }}
      </a>
    </div>
  </div>
</home-filter-widget>

{%- endif -%}
