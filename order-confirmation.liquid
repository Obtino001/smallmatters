    }
    
    h2, h3, h4 { 
      font-family: 'Playfair Display', Georgia, serif !important;
      font-weight: 400 !important; 
      color: #3B3B3B !important; 
      letter-spacing: 0px !important;
    }
    
    h2 { font-size: 32px !important; margin-bottom: 20px !important; text-align: center !important; }
    h3 { font-size: 22px !important; margin-top: 40px !important; margin-bottom: 20px !important; }
    
    p, span, td { 
      color: #3B3B3B !important; 
      font-size: 15px !important; 
      line-height: 1.7 !important; 
      font-weight: 400 !important;
    }
    
    .shop-name__text a { 
      font-family: 'Jost', sans-serif !important;
      font-weight: 500; 
      text-decoration: none !important;
      border-bottom: none !important;
      font-size: 22px; 
      letter-spacing: 3px; 
      text-transform: uppercase; 
      color: #3B3B3B !important;
    }
    
    /* Content Blocks - Transparent to blend perfectly with beige background */
    .content__cell {
      background-color: transparent !important;
      padding: 0 40px 40px 40px !important;
      border-radius: 0px !important;
      box-shadow: none !important;
    }
    
    .section__cell {
      background-color: transparent !important;
      padding: 0 40px 40px 40px !important;
      border-radius: 0px !important;
      box-shadow: none !important;
      margin-top: 0px !important;
    }
    
    /* Order List Refinements */
    .order-list__item {
      padding-top: 25px !important;
      padding-bottom: 25px !important;
      border-bottom: 1px solid rgba(59,59,59,0.1) !important;
    }
    
    .order-list__item:last-child {
      border-bottom: none !important;
    }
    
    .order-list__product-image {
      border-radius: 0px !important; /* Sharp corners on product image */
    }
    
    .order-list__item-title {
      font-weight: 500 !important;
      color: #3B3B3B !important;
    }
    
    .order-list__item-variant {
      color: #7A7A7A !important;
      font-size: 13px !important;
      margin-top: 4px !important;
      display: inline-block !important;
    }
    
    .order-list__item-price {
      font-weight: 500 !important;
      color: #3B3B3B !important;
    }
    
    /* Subtotals block */
    .subtotal-line__title p, .subtotal-line__value p {
      font-size: 13px !important;
      color: #5A5A5A !important;
      text-transform: uppercase !important;
      letter-spacing: 1px !important;
    }
    
    .subtotal-line__title--total p, .subtotal-line__value--total p {
      font-size: 16px !important;
      font-weight: 500 !important;
      color: #3B3B3B !important;
      text-transform: uppercase !important;
      letter-spacing: 1px !important;
    }
    
    .subtotal-table {
      margin-top: 30px !important;
      border-top: 1px solid rgba(59,59,59,0.1) !important;
      padding-top: 30px !important;
    }
  </style>
</head>

