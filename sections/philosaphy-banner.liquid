{% schema %}
{
  "name": "Philosophy Banner",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f6f6f6"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading / Quote",
      "default": "\"GO FOR WHAT YOU WANT AND GET IT.\""
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "When you wear ELSA, you're not just wearing a jumpsuit. You're wearing a solution designed by women, for women chasing their dreams."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "mobile center Image"
    },
    {
      "type": "image_picker",
      "id": "corner_image",
      "label": "Bottom Right Image"
    },
        {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Philosophy Banner",
    }
  ]
}
{% endschema %}
<section class="philo-banner-cc section-{{ section.id }}-padding" style="background-color: {{ section.settings.background_color }};">
<div class="philo-banner container-x">
  <div class="philo-banner__container">
    <div class="philo-banner__content">
      {% if section.settings.subheading != blank %}
        <h3 class="philo-banner__subheading">{{ section.settings.subheading }}</h3>
      {% endif %}

      {% if section.settings.main_heading != blank %}
        <h2 class="philo-banner__heading">{{ section.settings.main_heading }}</h2>
      {% endif %}

    {% if section.settings.mobile_image != blank %}
      <div class="philo-banner__image_mobile">
        <img 
          src="{{ section.settings.mobile_image | image_url}}" 
          alt="{{ section.settings.mobile_image.alt | escape }}"
          loading="lazy"
        >
      </div>
    {% endif %}
      {% if section.settings.description != blank %}
        <p class="philo-banner__description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="button button--primary">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.corner_image != blank %}
      <div class="philo-banner__image">
        <img 
          src="{{ section.settings.corner_image | image_url}}" 
          alt="{{ section.settings.corner_image.alt | escape }}"
          loading="lazy"
        >
      </div>
    {% endif %}
  </div>
</div>
</section>

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top_mobile }}px;
  padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
}
@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}
{%- endstyle -%}
<style>
  .philo-banner__image_mobile{
  display: none;
}
.philo-banner {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 440px;
    background: #f5f5f5;
}
.philo-banner__container {
  max-width: 1000px;
  text-align: center;
  margin: 0 auto;
}
.philo-banner__subheading {
font-weight: 500;
font-style: Regular;
font-size: 28px;
line-height: 130%;
letter-spacing: 12%;
text-transform: uppercase;
color: #545453;
}
.philo-banner__heading {
font-family: Inter;
font-weight: 500;
font-size: 34px;
line-height: 130%;
letter-spacing: 0%;
text-align: center;
text-transform: uppercase;
color: #000000;
}
.philo-banner__description {
font-family: Inter;
font-weight: 500;
font-size: 12px;
line-height: 120%;
letter-spacing: 0%;
text-align: center;
color: #545453;
max-width: 60%;
margin: 0 auto;
}
.philo-banner__image {
  position: absolute;
  bottom: 20px;
  right: 20px;
  width: 120px;
  opacity: 0.9;
}
.philo-banner__image img {
  width: 100%;
  height: auto;
  display: block;
}
@media (max-width: 768px) {
 .philo-banner__image_mobile {
    display: block;
    height: 285px;
}
.philo-banner__image_mobile  img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
}
  .philo-banner__subheading {
    font-size: 22px;
}
  .philo-banner {
    padding: 60px 16px 100px;
  }
  .philo-banner__heading {
    font-size: 24px;
  }
  .philo-banner__image {
    display: none;
  }
  .philo-banner__description {
    max-width: 85%;
    margin: 0 auto;
}
.philo-banner {
  height: 100%;
  background: transparent !important;
}
}
</style>
