                  <td style="padding: 0 8px;"><a href="https://www.tiktok.com/@smallmatters_oslo" target="_blank" style="border-bottom: none;"><img src="https://img.icons8.com/ios-glyphs/30/3B3B3B/tiktok.png" width="28" height="28" alt="TikTok" style="display: block; border: 0;"></a></td>
