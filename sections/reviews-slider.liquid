

{% schema %}
{
  "name": "Reviews Slider",
  "settings": [
     {
      "type": "header",
      "content": "Paddding Heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label":  "Paddding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label":  "Paddding Bottom",
      "default": 0
    },
        {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label":  "Paddding Top Mobile",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label":  "Paddding Bottom Mobile",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EBE8E3"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust Label",
      "default": "Trustpilot"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.8 stars | 200+ reviews"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay Speed",
      "default": 4000
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "Oct, 2025"
        },
        {
        "type": "image_picker",
        "id": "stars_image",
        "label": "Stars Image"
      },
        {
          "type": "text",
          "id": "headline",
          "label": "Review Headline",
          "default": "Minimal, elegant, and versatile."
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Review Content",
          "default": "The quality is exceptional — soft, warm, and beautifully made. I've never worn anything this comfortable."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Lorem Ipsum"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Slider",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}

<style>
#shopify-section-{{ section.id }} .rev-section {
background-color: {{ section.settings.bg_color }};
overflow: hidden; /* Safety wrapper */
}

#shopify-section-{{ section.id }} .rev-container {
display: flex;
gap: 0; 
}

#shopify-section-{{ section.id }} .rev-left {
  width: 22%;
flex-shrink: 0;
padding-inline: 40px;
display: flex;
flex-direction: column;
justify-content: center;
box-sizing: border-box;
justify-content: center;
align-items: center;
}

#shopify-section-{{ section.id }} .rev-heading {
font-family: Neue Haas Grotesk Display Pro;
font-weight: 500;
font-style: 55 Roman;
font-size: 32px;
leading-trim: NONE;
line-height: 100%;
letter-spacing: 0%;
color:#3C3C3C;
}

#shopify-section-{{ section.id }} .rev-right {
width: 78%;
position: relative;
overflow: hidden; /* THIS IS THE FIX: Keeps slider inside the 70% box */
min-width: 0;     /* Flexbox safety fix */
}

/* Swiper Container */
#shopify-section-{{ section.id }} .swiper-container-{{ section.id }} {
width: 100%;
height: 100%;
overflow: visible; /* Allows cards to overflow rightwards off screen if needed */
}

/* Review Card Styling */
#shopify-section-{{ section.id }} .swiper-slide {
width: 350px;
height: 300px;
background: #F8F6F3;
border-radius: 8px;
padding: 30px;
box-sizing: border-box;
display: flex;
flex-direction: column;
justify-content: space-between;
transition: transform 0.3s;
border: 1px solid #D8CFC4;
}

/* Trustpilot Mockup */
#shopify-section-{{ section.id }} .rev-trust-wrap {
display: flex;
align-items: center;
gap: 8px;
margin-bottom: 8px;
flex-direction: column;
}

#shopify-section-{{ section.id }} .rev-star-icon {
width: 20px;
height: 20px;
fill: #00b67a;
}

#shopify-section-{{ section.id }} .rev-trust-text {
font-weight: 600;
font-size: 16px;
}

#shopify-section-{{ section.id }} .rev-rating-details {
font-weight: 500;
font-style: Medium;
font-size: 14px;
leading-trim: NONE;
line-height: 100%;
letter-spacing: 0%;
text-decoration: underline;
text-decoration-style: solid;
text-decoration-offset: 0%;
text-decoration-thickness: 0%;
text-decoration-skip-ink: auto;
color: #545453;
}

/* Navigation Buttons */
#shopify-section-{{ section.id }} .rev-nav-wrapper {
display: flex;
gap: 7px;
margin-top: 10px;
}

#shopify-section-{{ section.id }} .rev-nav-btn {
width: 40px;
height: 20px;
cursor: pointer;
display: flex;
align-items: center;
justify-content: center;
transition: opacity 0.3s;
}

#shopify-section-{{ section.id }} .rev-nav-btn:hover {
opacity: 0.6;
}

#shopify-section-{{ section.id }} .rev-card-top {
display: flex;
justify-content: space-between;
align-items: center;
margin-block: 10px;
}

#shopify-section-{{ section.id }} .rev-stars-row {
display: flex;
gap: 2px;
}

#shopify-section-{{ section.id }} .rev-card-date {
font-family: Helvetica;
font-weight: 400;
font-style: Regular;
font-size: 12px;
leading-trim: NONE;
line-height: 100%;
letter-spacing: 0%;
color: #000000;
}

#shopify-section-{{ section.id }} .rev-card-headline {
font-family: Neue Haas Grotesk Display Pro;
font-weight: 500;
font-style: 55 Roman;
font-size: 18px;
leading-trim: NONE;
line-height: 100%;
letter-spacing: 0%;
color: #000000;
}

#shopify-section-{{ section.id }} .rev-card-content {
font-family: Lato;
font-weight: 400;
font-style: Regular;
font-size: 14px;
leading-trim: NONE;
line-height: 140%;
letter-spacing: 0%;
color: #000000;
}

#shopify-section-{{ section.id }} .rev-card-author {
font-family: Lato;
font-weight: 500;
font-style: Medium;
font-size: 14px;
leading-trim: NONE;
line-height: 100%;
letter-spacing: 0%;
color: #000000;
}
.rev-stars-image {
width: auto;
height: 20px;
display: block;
}

#shopify-section-{{ section.id }} .rev-right-wrapper .rev-right-slide:nth-child(even) {
    background: transparent !important;
}

.rev-nav-wrapper._desktop {
    display: flex !important;
}
.rev-nav-wrapper._mobile {
    display: none !important;
}

.rev-nav-btn {
  transition: opacity 0.3s ease;
  cursor: pointer;
}

.rev-nav-btn.swiper-button-disabled {
  opacity: 0.5;           /* Change to 0.3 if you want it slightly visible instead of hidden */
  pointer-events: none; /* Prevents clicking */
  cursor: not-allowed !important;
}
@media screen and (max-width: 900px) {
  #shopify-section-{{ section.id }} .rev-trust-wrap {
    align-items: end;

  }
  .rev-nav-wrapper._desktop {
    display: none !important;
}
 #shopify-section-{{ section.id }} .rev-nav-wrapper._mobile {
    display: flex !important;
    margin-top: 25px;
    justify-content: center;
}

#shopify-section-{{ section.id }} .rev-heading {
  font-size: 24px;
}
  #shopify-section-{{ section.id }} .rev-left {
    width: 100%;
    padding: 0;
    margin-bottom: 30px;
    align-items: flex-end;
    flex-direction: row;
    justify-content: space-between;
  }
#shopify-section-{{ section.id }} .rev-container {
    flex-direction: column;
    padding-inline: 10px;
}
  #shopify-section-{{ section.id }} .rev-right {
    width: 100%;
    overflow: visible; 
  }

  #shopify-section-{{ section.id }} .swiper-slide {
    width: 85vw;
  }
}
</style>
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  .section-{{ section.id }}-title{
    text-align: {{section.settings.title-align}};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
