<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordions = document.querySelectorAll('.custom-accordion');
    
    accordions.forEach(accordion => {
      const toggle = accordion.querySelector('.custom-accordion-toggle');
      const submenu = accordion.querySelector('.menu-drawer__submenu');
      
      if (!toggle || !submenu) return;
      
      // Initialize height if open by default
      if (accordion.classList.contains('is-open')) {
        submenu.style.maxHeight = submenu.scrollHeight + 'px';
      }
      
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        
        const isOpen = accordion.classList.contains('is-open');
        
        if (isOpen) {
          accordion.classList.remove('is-open');
          submenu.style.maxHeight = null;
        } else {
          // Close other accordions at the same level if desired
          // (Leaving them open independently is usually fine for mobile menus)
          accordion.classList.add('is-open');
          submenu.style.maxHeight = submenu.scrollHeight + 'px';
        }
      });
    });
    
    // Also re-calculate heights on window resize to prevent cut-offs
    window.addEventListener('resize', () => {
      accordions.forEach(accordion => {
        if (accordion.classList.contains('is-open')) {
          const submenu = accordion.querySelector('.menu-drawer__submenu');
          if(submenu) submenu.style.maxHeight = submenu.scrollHeight + 'px';
        }
      });
    });
  });
</script>
