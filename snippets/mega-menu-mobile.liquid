<div
  class="mega-menu mega-menu_body {% if block.settings.images_position == 'left' %}mega-menu--reverse{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="mega-menu_body__inner">
    {% assign img_1 = block.settings.image_1 %}
    {% assign img_2 = block.settings.image_2 %}
    {% assign img_3 = block.settings.image_3 %}
    
    {% assign menu_1 = block.settings.menu_1 %}
    {% assign menu_2 = block.settings.menu_2 %}
    {% assign menu_3 = block.settings.menu_3 %}
    {% assign menu_4 = block.settings.menu_4 %}
    {% assign menu_5 = block.settings.menu_5 %}

    {% assign title_1 = block.settings.title_1 %}
    {% assign title_2 = block.settings.title_2 %}
    {% assign title_3 = block.settings.title_3 %}
    {% assign title_4 = block.settings.title_4 %}
    {% assign title_5 = block.settings.title_5 %}

    {% assign title_1_link = block.settings.title_1_link %}
    {% assign title_2_link = block.settings.title_2_link %}
    {% assign title_3_link = block.settings.title_3_link %}
    {% assign title_4_link = block.settings.title_4_link %}
    {% assign title_5_link = block.settings.title_5_link %}

    <div class="custom_menu_menuss">
        {% comment %} --- MENU 1 --- {% endcomment %}
        {%- if menu_1.levels > 0 -%}
        <ul class="mega-menu__linklist custom_wrapper-column">
            {% if title_1 != blank %}
            <div class="mega-menu_title-body" href="{{ title_1_link }}">
                {{ title_1 }}
                {% render 'chevron-icon' %}
            </div>
        {% endif %}
            <div class="mega-menu__linklist_____inner">
                {%- for sub_link in menu_1.links -%}
                    <li class="custom_wrapper_item">
                        {%- if sub_link.links.size > 0 -%}
                        <div class="menu_wrapper----col">
                            <a class="h6 menu_wrapper" href="{{ sub_link.url }}">
                            {{ sub_link.title | escape }}
                            </a>
                            <span>{% render 'chevron-icon' %}</span>
                        </div>
                        {% else %}
                        <a href="{{ sub_link.url }}" class="h6 menu_wrapper">{{ sub_link.title | escape }}</a>
                        {% endif %}
                        {%- if sub_link.links.size > 0 -%}
                        <ul class="custom_wrapper_item_ul">
                            {%- for sub_sub_link in sub_link.links -%}
                            <li class="item_menu_wrapper">
                                {% if sub_sub_link.links != blank %}
                                <div class="link-faded sub_menu_wrapper">
                                    {{ sub_sub_link.title | escape }}
                                    {% render 'chevron-icon' %}
                                </div>
                                {% else %}
                                <a href="{{ sub_sub_link.url }}" class="link-faded sub_menu_wrapper">{{ sub_sub_link.title | escape }}</a>
                                {% endif %}
                                {% if sub_sub_link.links != blank %}
                                <ul class="grandchild">
                                    {% for grandchild_link in sub_sub_link.links %}
                                    <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a></li>
                                    {% endfor %}
                                </ul>
                                {% endif %}
                            </li>
                            {%- endfor -%}
                        </ul>
                        {%- endif -%}
                    </li>
                {%- endfor -%}
            </div>
        </ul>
        {%- endif -%}

        {% comment %} --- MENU 2 --- {% endcomment %}
        {%- if menu_2.levels > 0 -%}
        <ul class="mega-menu__linklist custom_wrapper-column">
                        {% if title_2 != blank %}
            <div class="mega-menu_title-body" href="{{ title_2_link }}">
                {{ title_2 }}
                {% render 'chevron-icon' %}
            </div>
                    {% endif %}
            <div class="mega-menu__linklist_____inner">
            {%- for sub_link in menu_2.links -%}
            <li class="custom_wrapper_item">
                {%- if sub_link.links.size > 0 -%}
                <div class="menu_wrapper----col">
                    <a class="h6 menu_wrapper" href="{{ sub_link.url }}">
                    {{ sub_link.title | escape }}
                    </a>
                    <span>{% render 'chevron-icon' %}</span>
                </div>
                {% else %}
                <a href="{{ sub_link.url }}" class="h6 menu_wrapper">{{ sub_link.title | escape }}</a>
                {% endif %}
                {%- if sub_link.links.size > 0 -%}
                <ul class="custom_wrapper_item_ul">
                    {%- for sub_sub_link in sub_link.links -%}
                    <li class="item_menu_wrapper">
                        {% if sub_sub_link.links != blank %}
                        <div class="link-faded sub_menu_wrapper">
                            {{ sub_sub_link.title | escape }}
                            {% render 'chevron-icon' %}
                        </div>
                        {% else %}
                        <a href="{{ sub_sub_link.url }}" class="link-faded sub_menu_wrapper">{{ sub_sub_link.title | escape }}</a>
                        {% endif %}
                        {% if sub_sub_link.links != blank %}
                        <ul class="grandchild">
                            {% for grandchild_link in sub_sub_link.links %}
                            <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </li>
                    {%- endfor -%}
                </ul>
                {%- endif -%}
            </li>
            {%- endfor -%}
            </div>
        </ul>
        {%- endif -%}

        {% comment %} --- MENU 3 --- {% endcomment %}
        {%- if menu_3.levels > 0 -%}
        <ul class="mega-menu__linklist custom_wrapper-column">
                        {% if title_3 != blank %}

            <div class="mega-menu_title-body" href="{{ title_3_link }}">
                {{ title_3 }}
                {% render 'chevron-icon' %}
            </div>
                    {% endif %}

            <div class="mega-menu__linklist_____inner">
            {%- for sub_link in menu_3.links -%}
            <li class="custom_wrapper_item">
                {%- if sub_link.links.size > 0 -%}
                <div class="menu_wrapper----col">
                    <a class="h6 menu_wrapper" href="{{ sub_link.url }}">
                    {{ sub_link.title | escape }}
                    </a>
                    <span>{% render 'chevron-icon' %}</span>
                </div>
                {% else %}
                <a href="{{ sub_link.url }}" class="h6 menu_wrapper">{{ sub_link.title | escape }}</a>
                {% endif %}
                {%- if sub_link.links.size > 0 -%}
                <ul class="custom_wrapper_item_ul">
                    {%- for sub_sub_link in sub_link.links -%}
                    <li class="item_menu_wrapper">
                        {% if sub_sub_link.links != blank %}
                        <div class="link-faded sub_menu_wrapper">
                            {{ sub_sub_link.title | escape }}
                            {% render 'chevron-icon' %}
                        </div>
                        {% else %}
                        <a href="{{ sub_sub_link.url }}" class="link-faded sub_menu_wrapper">{{ sub_sub_link.title | escape }}</a>
                        {% endif %}
                        {% if sub_sub_link.links != blank %}
                        <ul class="grandchild">
                            {% for grandchild_link in sub_sub_link.links %}
                            <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </li>
                    {%- endfor -%}
                </ul>
                {%- endif -%}
            </li>
            {%- endfor -%}
            </div>
        </ul>
        {%- endif -%}

        {% comment %} --- MENU 4 --- {% endcomment %}
        {%- if menu_4.levels > 0 -%}
        <ul class="mega-menu__linklist unstyled-list custom_wrapper-column">
            <a class="mega-menu_title-body" href="{{ title_4_link }}">{{ title_4 }}</a>
            {%- for sub_link in menu_4.links -%}
            <li class="custom_wrapper_item">
                {%- if sub_link.links.size > 0 -%}
                <div class="menu_wrapper----col">
                    <a class="h6 menu_wrapper" href="{{ sub_link.url }}">{{ sub_link.title | escape }}</a>
                    <span>{% render 'chevron-icon' %}</span>
                </div>
                {% else %}
                <a href="{{ sub_link.url }}" class="h6 menu_wrapper">{{ sub_link.title | escape }}</a>
                {% endif %}
                {%- if sub_link.links.size > 0 -%}
                <ul class="custom_wrapper_item_ul">
                    {%- for sub_sub_link in sub_link.links -%}
                    <li class="item_menu_wrapper">
                        <a href="{{ sub_sub_link.url }}" class="link-faded sub_menu_wrapper">{{ sub_sub_link.title | escape }}</a>
                    </li>
                    {%- endfor -%}
                </ul>
                {%- endif -%}
            </li>
            {%- endfor -%}
        </ul>
        {%- endif -%}

        {% comment %} --- MENU 5 --- {% endcomment %}
        {%- if menu_5.levels > 0 -%}
        <ul class="mega-menu__linklist unstyled-list custom_wrapper-column">
            <a class="mega-menu_title-body" href="{{ title_5_link }}">{{ title_5 }}</a>
            {%- for sub_link in menu_5.links -%}
            <li class="custom_wrapper_item">
                {%- if sub_link.links.size > 0 -%}
                <div class="menu_wrapper----col">
                    <a class="h6 menu_wrapper" href="{{ sub_link.url }}">{{ sub_link.title | escape }}</a>
                    <span>{% render 'chevron-icon' %}</span>
                </div>
                {% else %}
                <a href="{{ sub_link.url }}" class="h6 menu_wrapper">{{ sub_link.title | escape }}</a>
                {% endif %}
                {%- if sub_link.links.size > 0 -%}
                <ul class="custom_wrapper_item_ul">
                    {%- for sub_sub_link in sub_link.links -%}
                    <li class="item_menu_wrapper">
                        <a href="{{ sub_sub_link.url }}" class="link-faded sub_menu_wrapper">{{ sub_sub_link.title | escape }}</a>
                    </li>
                    {%- endfor -%}
                </ul>
                {%- endif -%}
            </li>
            {%- endfor -%}
        </ul>
        {%- endif -%}
    </div>

    <div class="custom_menu_images {% if img_1 != blank and img_2 == blank and img_3 == blank %}only_one_image{% endif %}">
        {% for i in (1..3) %}
            {% assign image_key = "image_" | append: i %}
            {% assign image = block.settings[image_key] %}
            {% assign link_key = "image_" | append: i | append: "_link" %}
            {% assign link = block.settings[link_key] %}
            {% assign title_key = "image_" | append: i | append: "_title" %}
            {% assign title = block.settings[title_key] %}
            {% assign text_key = "image_" | append: i | append: "_text" %}
            {% assign text = block.settings[text_key] %}

            {% if image != blank %}
            <a class="custom_menu_image_item" href="{{ link }}">
                <div class="custom_menu_image_item-image">
                    {% render 'lx-liquid-image', image: image %}
                </div>
                <div class="custom_menu_image_item_info">
                {% if title != blank %}
                    <h3 class="custom_menu_image_title">{{ title }}</h3>
                {% endif %}
                {% if text != blank %}
                    <p class="custom_menu_image_text">{{ text }}</p>
                {% endif %}
                </div>
            </a>
            {% endif %}
        {% endfor %}
    </div>

    {% comment %} --- PRODUCTS LOOP (1 to 5) --- {% endcomment %}
    <div class="custom_menu_products">
        {% for i in (1..5) %}
            {% assign product_key = "product_" | append: i %}
            {% assign product_item = block.settings[product_key] %}
            
            {% if product_item != blank %}
                <div class="custom_menu_product_item">
                    {% render 'card-product',
                        card_product: product_item,
                        media_aspect_ratio: section.settings.image_ratio,
                        image_shape: section.settings.image_shape,
                        lazy_load: lazy_load,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        skip_styles: skip_card_product_styles,
                        section_id: section.id,
                        quick_add: section.settings.quick_add
                    %}
                </div>
            {% endif %}
        {% endfor %}
    </div>

    {% comment %} --- ARTICLES LOOP (1 to 5) --- {% endcomment %}
    {% assign article_2 = block.settings.article_2 %}
    <div class="custom_menu_article_wrapper {% if article_2 != blank %}has_multiBlogs{% endif %}">
        {% for i in (1..5) %}
            {% assign article_key = "article_" | append: i %}
            {% assign article_item = block.settings[article_key] %}

            {% if article_item != blank %}
                <div class="custom_menu_article_item mega_menu___column__box">
                    {%- render 'article-card',
                        article: article_item,
                        media_height: block.settings.image_height,
                        media_aspect_ratio: article_item.image.aspect_ratio,
                        show_image: block.settings.show_image,
                        show_date: block.settings.show_date,
                        show_author: block.settings.show_author,
                        show_excerpt: true
                    -%}
                </div>
            {% endif %}
        {% endfor %}
    </div>



    <div class="mobileMega-block">
{% if block.settings.heading != blank %}
<div class="mobileMega-block-heading">{{ block.settings.heading }}</div>
{% endif %}
{% render 'images-grid', block: block %}
</div>
  </div>
</div>