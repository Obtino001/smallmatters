      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
  ],
  "blocks": [
    {
  "type": "block",
  "name": "Tab",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Tab label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show tab",
      "default": true
    }
  ]
},
    {
      "type": "countdown_promo",
      "name": "Countdown Promo Card",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "bg_image", "label": "Background image" },
        { "type": "text", "id": "header", "label": "Heading", "default": "Spar op til 50% på madrasser" },
        { "type": "text", "id": "headline", "label": "Subheadline", "default": "Udsalget slutter om:" },
        { "type": "number", "id": "insert_after", "label": "Insert after product #", "default": 4 },
        { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 40 }
      ]
    },
    {
      "type": "trustpilot_promo",
      "name": "Trustpilot Promo Card",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "bg_image", "label": "Background image" },
        { "type": "image_picker", "id": "logo", "label": "Trustpilot logo" },
        { "type": "text", "id": "headline", "label": "Headline", "default": "Mere end 800 kunder har forelsket sig i vores madrasser!" },
        { "type": "text", "id": "reviewer_name", "label": "Reviewer name", "default": "Helene" },
        { "type": "image_picker", "id": "logo-s", "label": "Trustpilot stars" },
        { "type": "text", "id": "review_text", "label": "Review text", "default": "Der var intet at klage over vedrørende levering..." },
        { "type": "number", "id": "insert_after", "label": "Insert after product #", "default": 8 },
        { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection"
    }
  ]
