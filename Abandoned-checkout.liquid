{% capture email_title %}Noen ganger trenger man litt ekstra tid før man bestemmer seg.{% endcapture %}
{% capture email_body %}
  {% if billing_address.first_name %}
    <p>Hei {{ billing_address.first_name }},</p>
  {% else %}
    <p>Hei,</p>
  {% endif %}
  <p>Varene du valgte ligger fortsatt i handlekurven din, men vi vet at kashmir og ull er produkter som gjerne bør oppleves før man bestemmer seg.</p>
  <p>Derfor er du også hjertelig velkommen til å besøke butikken vår i Holmenveien 20. Her kan du se, kjenne og prøve genserne i ro og mak, og vi hjelper deg gjerne med å finne riktig størrelse, modell og farge.</p>
  <p>Dersom du allerede har bestemt deg, kan du enkelt fullføre bestillingen ved å klikke nedenfor.</p>
{% endcapture %}

<!DOCTYPE html>
<html lang="nb">
  <head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500&family=Playfair+Display:wght@400;500&display=swap');
    
    body, .body, .bodyTable, table.body, table.container { 
      background-color: #EFECE8 !important; /* Premium warm beige based on the screenshot */
      font-family: 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    }
    
    .button__cell { 
      background-color: #3B3B3B !important; /* Charcoal black from button */
      border-radius: 0px !important; /* Sharp corners */
    }
    
    .button__text {
      color: #FFFFFF !important;
      font-family: 'Jost', sans-serif !important;
      font-weight: 500 !important;
      letter-spacing: 2px !important;
      text-transform: uppercase !important;
      font-size: 12px !important;
      padding: 18px 30px !important;
      display: inline-block !important;
      text-decoration: none !important;
    }
    
    a, a:hover, a:active, a:visited { color: #3B3B3B; text-decoration: none; border-bottom: 1px solid #3B3B3B; }
    
    /* Minimalist Overrides for Layout */
    table, tr, td, .container, .order-list__item, .order-list__item__cell, .order-list__price-cell, .subtotal-line, .subtotal-table, .row.section, .row { 
      border: none !important; border-bottom: none !important; border-top: none !important; 
    }
    
    table.header.row, td.header__cell { 
      background-color: transparent !important; 
      padding-top: 50px !important; 
      padding-bottom: 20px !important; 
    }
    
    table.footer.row, td.footer__cell { 
      background-color: transparent !important; 
    }
    
    h2, h3, h4 { 
      font-family: 'Playfair Display', Georgia, serif !important;
      font-weight: 400 !important; 
      color: #3B3B3B !important; 
      letter-spacing: 0px !important;
    }
    
    h2 { font-size: 32px !important; margin-bottom: 20px !important; text-align: center !important; }
    h3 { font-size: 22px !important; margin-top: 40px !important; margin-bottom: 20px !important; }
    
    p, span, td { 
      color: #3B3B3B !important; 
      font-size: 15px !important; 
      line-height: 1.7 !important; 
      font-weight: 400 !important;
    }
    
    .shop-name__text a { 
      font-family: 'Jost', sans-serif !important;
      font-weight: 500; 
      text-decoration: none !important;
      border-bottom: none !important;
      font-size: 22px; 
      letter-spacing: 3px; 
      text-transform: uppercase; 
      color: #3B3B3B !important;
    }
    
    /* Content Blocks - Transparent to blend perfectly with beige background */
    .content__cell {
      background-color: transparent !important;
      padding: 0 40px 40px 40px !important;
      border-radius: 0px !important;
      box-shadow: none !important;
    }
    
    .section__cell {
      background-color: transparent !important;
      padding: 0 40px 40px 40px !important;
      border-radius: 0px !important;
      box-shadow: none !important;
      margin-top: 0px !important;
    }
    
    /* Order List Refinements */
    .order-list__item {
      padding-top: 25px !important;
      padding-bottom: 25px !important;
      border-bottom: 1px solid rgba(59,59,59,0.1) !important;
    }
    
    .order-list__item:last-child {
      border-bottom: none !important;
    }
    
    .order-list__product-image {
      border-radius: 0px !important; /* Sharp corners on product image */
    }
    
    .order-list__item-title {
      font-weight: 500 !important;
      color: #3B3B3B !important;
    }
    
    .order-list__item-variant {
      color: #7A7A7A !important;
      font-size: 13px !important;
      margin-top: 4px !important;
      display: inline-block !important;
    }
    
    .order-list__item-price {
      font-weight: 500 !important;
      color: #3B3B3B !important;
    }
    
    /* Subtotals block */
    .subtotal-line__title p, .subtotal-line__value p {
      font-size: 13px !important;
      color: #5A5A5A !important;
      text-transform: uppercase !important;
      letter-spacing: 1px !important;
    }
    
    .subtotal-line__title--total p, .subtotal-line__value--total p {
      font-size: 16px !important;
      font-weight: 500 !important;
      color: #3B3B3B !important;
      text-transform: uppercase !important;
      letter-spacing: 1px !important;
    }
    
    .subtotal-table {
      margin-top: 30px !important;
      border-top: 1px solid rgba(59,59,59,0.1) !important;
      padding-top: 30px !important;
    }
  </style>
</head>

