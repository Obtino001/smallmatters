{% comment %}
  Gymshark-Style Mobile Menu Drawer
  ----------------------------------
  Replicates Gymshark's mobile navigation pixel-for-pixel.
  - Full-screen slide-in drawer from left
  - Search bar with placeholder
  - Top-level category tabs (horizontal scroll)
  - Featured image cards carousel per category
  - Multi-level submenu with slide transitions
  - Back buttons for nested menus
  - Bottom utility links (Accessibility Statement, Help, etc.)
  - All items editable through Shopify Navigation settings
  - Preloaded on page load for instant open

  Usage: {% render 'header-drawer' %}
{% endcomment %}

{%- comment -%} Preload the drawer CSS so there's no FOUC {%- endcomment -%}
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}">

{%- comment -%} Build the mega menu block lookup {%- endcomment -%}
{%- liquid
  assign menu_links = section.settings.menu.links
-%}

<!-- ============================================ -->
<!-- GYMSHARK MOBILE DRAWER (preloaded in DOM)    -->
<!-- ============================================ -->
<div id="gs-mobile-drawer" class="gs-drawer" role="dialog" aria-modal="true" aria-label="Mobile navigation menu">
  <!-- Overlay/Backdrop -->
  <div class="gs-drawer__backdrop" data-gs-close></div>

  <!-- Drawer Panel -->
  <div class="gs-drawer__panel">
    <!-- ===== TOP ACTION BAR (Close + Wishlist + Account) ===== -->
    <div class="gs-drawer__actions">
      <button class="gs-drawer__close" type="button" aria-label="Close menu" data-gs-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="gs-drawer__actions-right">
        <a href="{{ routes.account_url }}" class="gs-drawer__icon-link" aria-label="View account">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
        <button type="button" class="gs-drawer__icon-link" id="cart-icon-bubble-drawer" aria-label="{{ 'templates.cart.cart' | t }}" data-gs-open-cart>
          <span class="svg-wrapper" style="display: flex; align-items: center; justify-content: center;"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="20" viewBox="0 0 19 20" fill="none">
            <mask id="mask0_drawer_cart" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="1" y="1" width="17" height="17">
              <path d="M17.2464 1.65829H1.32682V17.5779H17.2464V1.65829Z" fill="white"/>
            </mask>
            <g mask="url(#mask0_drawer_cart)">
              <path d="M14.5931 5.37195H3.98002V16.4493H14.5931V5.37195Z" stroke="currentColor" stroke-width="0.994974" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7.62828 7.03128V3.64837C7.62828 3.18405 8.02627 2.78606 8.49059 2.78606H10.2152C10.6795 2.78606 11.0775 3.18405 11.0775 3.64837V7.09761" stroke="currentColor" stroke-width="0.994974" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
            </g>
          </svg></span>
          {% comment %} <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div> {% endcomment %}
        </button>
      </div>
    </div>

    <!-- ===== SEARCH BAR ===== -->
    <div class="gs-drawer__search">
      <div class="gs-drawer__search-form" data-gs-search-trigger style="cursor: pointer;">
        <svg class="gs-drawer__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.5"/>
          <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input
          type="text"
          readonly
          placeholder="{{ 'general.search.placeholder' | t | default: 'Search for products' }}"
          class="gs-drawer__search-input"
          style="cursor: pointer;"
          aria-label="Search"
        >
      </div>
    </div>

    <!-- ===== SCROLLABLE CONTENT AREA ===== -->
    <div class="gs-drawer__content">
      <!-- ===== CATEGORY TABS ===== -->
      <div class="gs-drawer__tabs" role="tablist">
        {%- for link in menu_links -%}
          <button
            class="gs-drawer__tab{% if forloop.first %} gs-drawer__tab--active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="gs-category-{{ forloop.index }}"
            data-gs-tab="{{ forloop.index }}"
            id="gs-tab-{{ forloop.index }}"
          >
            {{ link.title | escape }}
          </button>
        {%- endfor -%}
      </div>

      <!-- ===== CATEGORY PANELS ===== -->
      <div class="gs-drawer__panels">
        {%- for link in menu_links -%}
          {%- comment -%} Find if this link has a mega menu block {%- endcomment -%}
          {%- assign mega_block = nil -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'desktop_menu' -%}
              {%- assign triggers = block.settings.trigger | downcase | split: ',' -%}
              {%- assign link_handle = link.handle | downcase -%}
              {%- assign link_title = link.title | downcase -%}
              {%- assign link_handle_spaced = link.handle | downcase | replace: '-', ' ' -%}
              {%- for trigger in triggers -%}
                {%- assign clean_trigger = trigger | strip -%}
                {%- if link_handle == clean_trigger or link_title == clean_trigger or link_handle_spaced == clean_trigger -%}
                  {%- assign mega_block = block -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if mega_block -%}{%- break -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          <div
            class="gs-drawer__panel-category{% if forloop.first %} gs-drawer__panel-category--active{% endif %}"
            role="tabpanel"
            id="gs-category-{{ forloop.index }}"
            aria-labelledby="gs-tab-{{ forloop.index }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <!-- Menu Items List -->
            <ul class="gs-drawer__menu" role="list">
              {%- assign has_mega_menus = false -%}
              {%- if mega_block -%}
                {%- if mega_block.settings.title_1 != blank or mega_block.settings.title_2 != blank or mega_block.settings.title_3 != blank -%}
                  {%- assign has_mega_menus = true -%}
                {%- endif -%}
                {%- comment -%} Also check if any menu linklist has links even without a title {%- endcomment -%}
                {%- unless has_mega_menus -%}
                  {%- for mi in (1..3) -%}
                    {%- assign mk = 'menu_' | append: mi -%}
                    {%- assign ml = linklists[mega_block.settings[mk]] -%}
                    {%- if ml.links != blank -%}
                      {%- assign has_mega_menus = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endunless -%}
              {%- endif -%}

              {%- assign has_custom_items = false -%}
              {%- if mega_block and mega_block.settings.item_title_1 != blank -%}
                {%- assign has_custom_items = true -%}
              {%- endif -%}

              {%- if has_mega_menus -%}
                {%- for i in (1..3) -%}
                  {%- assign title_key = 'title_' | append: i -%}
                  {%- assign link_key = 'title_' | append: i | append: '_link' -%}
                  {%- assign menu_key = 'menu_' | append: i -%}
                  
                  {%- assign col_title = mega_block.settings[title_key] -%}
                  {%- assign col_link = mega_block.settings[link_key] -%}
                  {%- assign col_menu = mega_block.settings[menu_key] -%}
                  {%- assign col_linklist = linklists[col_menu] -%}

                  {%- comment -%} Use the linklist title as fallback if column title is blank {%- endcomment -%}
                  {%- assign display_title = col_title -%}
                  {%- if display_title == blank and col_linklist.links != blank -%}
                    {%- assign display_title = col_linklist.title | default: col_menu | replace: '-', ' ' | capitalize -%}
                  {%- endif -%}

                  {%- if display_title != blank -%}
                    <li class="gs-drawer__menu-item">
                      {%- if col_linklist.links != blank -%}
                        <button class="gs-drawer__menu-btn" data-gs-submenu="submenu-mega-{{ forloop.parentloop.index }}-{{ i }}" aria-expanded="false">
                          <span class="gs-drawer__menu-text">{{ display_title | escape }}</span>
                          <svg class="gs-drawer__chevron" width="8" height="14" viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                        <div class="gs-drawer__submenu" id="submenu-mega-{{ forloop.parentloop.index }}-{{ i }}" aria-hidden="true">
                          <div class="gs-drawer__submenu-inner">
                            <button class="gs-drawer__back" data-gs-back aria-label="Back to {{ link.title }}">
                              <svg width="8" height="14" viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M7 13L1 7L7 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                              <span>{{ display_title | escape }}</span>
                            </button>
                            <ul class="gs-drawer__submenu-list" role="list">
                              {%- for childlink in col_linklist.links -%}
                                <li>
                                  <a href="{{ childlink.url }}" class="gs-drawer__submenu-link">{{ childlink.title | escape }}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        </div>
                      {%- else -%}
                        <a href="{{ col_link | default: '#' }}" class="gs-drawer__menu-link">
                          <span class="gs-drawer__menu-text">{{ display_title | escape }}</span>
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif link.links != blank -%}
                {%- for childlink in link.links -%}
                  <li class="gs-drawer__menu-item">
                    {%- if childlink.links != blank -%}
                      <button class="gs-drawer__menu-btn" data-gs-submenu="submenu-{{ forloop.parentloop.index }}-{{ forloop.index }}" aria-expanded="false">
                        <span class="gs-drawer__menu-text">{{ childlink.title | escape }}</span>
                        <svg class="gs-drawer__chevron" width="8" height="14" viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                      <div class="gs-drawer__submenu" id="submenu-{{ forloop.parentloop.index }}-{{ forloop.index }}" aria-hidden="true">
                        <div class="gs-drawer__submenu-inner">
                          <button class="gs-drawer__back" data-gs-back aria-label="Back to {{ link.title }}">
                            <svg width="8" height="14" viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M7 13L1 7L7 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>{{ childlink.title | escape }}</span>
                          </button>
                          <ul class="gs-drawer__submenu-list" role="list">
                            {%- for grandchild in childlink.links -%}
                              <li>
                                <a href="{{ grandchild.url }}" class="gs-drawer__submenu-link">{{ grandchild.title | escape }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    {%- else -%}
                      <a href="{{ childlink.url }}" class="gs-drawer__menu-link">
                        <span class="gs-drawer__menu-text">{{ childlink.title | escape }}</span>
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              {%- elsif has_custom_items -%}
                <li class="gs-drawer__menu-item" style="padding: 16px;">
                  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
                    {%- for i in (1..12) -%}
                      {%- assign title_key = 'item_title_' | append: i -%}
                      {%- assign link_key = 'item_link_' | append: i -%}
                      {%- assign image_key = 'item_image_' | append: i -%}
                      
                      {%- if mega_block.settings[title_key] != blank -%}
                        <a href="{{ mega_block.settings[link_key] | default: '#' }}" style="display: flex; flex-direction: column; gap: 8px; text-decoration: none;">
                          {%- if mega_block.settings[image_key] != blank -%}
                            <div style="aspect-ratio: 4/3; overflow: hidden; background: #f4f4f4; border-radius: 4px;">
                              <img src="{{ mega_block.settings[image_key] | image_url: width: 300 }}" alt="{{ mega_block.settings[title_key] | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                          {%- endif -%}
                          <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: #000;">{{ mega_block.settings[title_key] }}</span>
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </li>
              {%- else -%}
                <li class="gs-drawer__menu-item">
                  <a href="{{ link.url }}" class="gs-drawer__menu-link">
                    <span class="gs-drawer__menu-text">{{ link.title | escape }}</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>

            <!-- Featured Image Cards (horizontal scroll) — shown BELOW menu items -->
            {%- if mega_block -%}
              {%- assign has_featured = false -%}
              {%- if mega_block.settings.image_1 != blank or mega_block.settings.image_2 != blank or mega_block.settings.image_3 != blank -%}
                {%- assign has_featured = true -%}
              {%- endif -%}
              {%- for i in (1..5) -%}
                {%- assign product_key = 'product_' | append: i -%}
                {%- if mega_block.settings[product_key] != blank -%}{%- assign has_featured = true -%}{%- endif -%}
                {%- assign article_key = 'article_' | append: i -%}
                {%- if mega_block.settings[article_key] != blank -%}{%- assign has_featured = true -%}{%- endif -%}
              {%- endfor -%}

              {%- if has_featured -%}
                <div class="gs-drawer__featured">
                  <div class="gs-drawer__featured-scroll">
                    {%- for i in (1..3) -%}
                      {%- assign img_key = 'image_' | append: i -%}
                      {%- assign img_link_key = 'image_' | append: i | append: '_link' -%}
                      {%- assign img_title_key = 'image_' | append: i | append: '_title' -%}
                      
                      {%- if mega_block.settings[img_key] != blank -%}
                        <a href="{{ mega_block.settings[img_link_key] | default: '#' }}" class="gs-drawer__featured-card">
                          <div class="gs-drawer__featured-img">
                            <img
                              src="{{ mega_block.settings[img_key] | image_url: width: 400 }}"
                              alt="{{ mega_block.settings[img_title_key] | default: link.title }}"
                              loading="lazy"
                              width="180"
                              height="180"
                            >
                            <div class="gs-drawer__featured-gradient"></div>
                          </div>
                          {%- if mega_block.settings[img_title_key] != blank -%}
                            <h3 class="gs-drawer__featured-title">{{ mega_block.settings[img_title_key] }}</h3>
                          {%- endif -%}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- for i in (1..5) -%}
                      {%- assign product_key = 'product_' | append: i -%}
                      {%- assign product_item = mega_block.settings[product_key] -%}
                      {%- if product_item != blank -%}
                        <div class="gs-drawer__featured-card gs-drawer__product-card">
                          {% render 'card-product-color-swatches',
                            show_swatches: true,
                            swatch_limit: 3,
                            card_product: product_item,
                            media_aspect_ratio: section.settings.image_ratio,
                            image_shape: section.settings.image_shape,
                            lazy_load: true,
                            show_secondary_image: section.settings.show_secondary_image,
                            show_vendor: section.settings.show_vendor,
                            show_rating: section.settings.show_rating,
                            section_id: section.id,
                            quick_add: section.settings.quick_add
                          %}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- for i in (1..5) -%}
                      {%- assign article_key = 'article_' | append: i -%}
                      {%- assign article_item = mega_block.settings[article_key] -%}
                      {%- if article_item != blank -%}
                        <div class="gs-drawer__featured-card gs-drawer__article-card">
                          {%- render 'article-card',
                              article: article_item,
                              media_height: mega_block.settings.image_height,
                              media_aspect_ratio: article_item.image.aspect_ratio,
                              show_image: mega_block.settings.show_image,
                              show_date: mega_block.settings.show_date,
                              show_author: mega_block.settings.show_author,
                              show_excerpt: true
                          -%}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}

            <!-- Bottom Utility Links (pulled from mega menu block's "Smallmatters World" items or a secondary menu) -->
            {%- if link.links != blank -%}
              <div class="gs-drawer__utility">
                {%- comment -%}
                  If the mega_block has world items, show them here.
                  Otherwise these would be filled from a secondary Shopify menu.
                {%- endcomment -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <!-- ===== BOTTOM UTILITY LINKS (global) ===== -->
      {%- assign has_bottom_links = false -%}
      {%- if linklists['footer'].links != blank -%}
        {%- for flink in linklists['footer'].links -%}
          {%- if flink.title contains 'Accessibility' or flink.title contains 'Help' or flink.title contains 'Email' or flink.title contains 'Blog' or flink.title contains 'Kundeservice' or flink.title contains 'Kontakt' -%}
            {%- assign has_bottom_links = true -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      <div class="gs-drawer__footer-section">
        {%- if has_bottom_links -%}
          <div class="gs-drawer__bottom-links">
            {%- for flink in linklists['footer'].links -%}
              {%- if flink.title contains 'Accessibility' or flink.title contains 'Help' or flink.title contains 'Email' or flink.title contains 'Blog' or flink.title contains 'Kundeservice' or flink.title contains 'Kontakt' -%}
                <a href="{{ flink.url }}" class="gs-drawer__bottom-link">{{ flink.title | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Localization selector {%- endcomment -%}
        {%- if localization.available_countries or localization.available_languages -%}
          <div class="gs-drawer__localization">
            <localization-form>
              {%- form 'localization', id: 'GS-LocalizationForm-Mobile', class: 'localization-form' -%}
                <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
                <input type="hidden" name="language_code" value="{{ localization.language.iso_code }}">
                <div class="gs-drawer__lang-selector">
                  <input type="checkbox" class="gs-drawer__lang-toggle" id="gs-lang-toggle" hidden style="display: none !important;">
                  <label for="gs-lang-toggle" class="gs-drawer__lang-current">
                    {% if localization.language.iso_code == 'en' %}
                      <img class="gs-drawer__flag" src="https://cdn.shopify.com/s/files/1/0082/0228/9219/files/Flag_of_the_United_States_svg.png?v=1765303150" alt="English" width="20" height="14">
                      <span>USD $</span>
                    {% else %}
                      <img class="gs-drawer__flag" src="https://cdn.shopify.com/s/files/1/0082/0228/9219/files/Flag_of_Norway_svg.png?v=1765303113" alt="Norsk" width="20" height="14">
                      <span>NOK kr</span>
                    {% endif %}
                    <svg class="gs-drawer__lang-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </label>
                  <div class="gs-drawer__lang-options">
                    {%- for language in localization.available_languages -%}
                      <a href="#" class="gs-drawer__lang-option {% if language.iso_code == localization.language.iso_code %}gs-drawer__lang-option--active{% endif %}" data-language-code="{{ language.iso_code }}">
                        {%- if language.iso_code == 'nb' or language.iso_code == 'no' -%}
                          <img class="gs-drawer__flag" src="https://cdn.shopify.com/s/files/1/0082/0228/9219/files/Flag_of_Norway_svg.png?v=1765303113" alt="Norsk" width="20" height="14">
                          <span>kr NOK</span>
                        {%- elsif language.iso_code == 'en' -%}
                          <img class="gs-drawer__flag" src="https://cdn.shopify.com/s/files/1/0082/0228/9219/files/Flag_of_the_United_States_svg.png?v=1765303150" alt="English" width="20" height="14">
                          <span>$ USD</span>
                        {%- endif -%}
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endform -%}
            </localization-form>
          </div>
        {%- endif -%}
      </div>
    </div><!-- .gs-drawer__content -->
  </div><!-- .gs-drawer__panel -->
</div>

<!-- ============================================ -->
<!-- HAMBURGER TRIGGER BUTTON                     -->
<!-- ============================================ -->
<button
  class="gs-hamburger header__icon header__icon--menu"
  type="button"
  aria-label="{{ 'sections.header.menu' | t }}"
  aria-controls="gs-mobile-drawer"
  aria-expanded="false"
  data-gs-open
>
  <svg class="gs-hamburger__icon" xmlns="http://www.w3.org/2000/svg" width="21" height="14" viewBox="0 0 21 14" fill="none">
    <path d="M0 0.75H21" stroke="currentColor" stroke-width="1.5"/>
    <path d="M5 6.75L16 6.75" stroke="currentColor" stroke-width="1.5"/>
    <path d="M0 12.75H21" stroke="currentColor" stroke-width="1.5"/>
  </svg>
</button>

<!-- ============================================ -->
<!-- DRAWER JAVASCRIPT                            -->
<!-- ============================================ -->
<script>
  (function() {
    'use strict';

    const drawer = document.getElementById('gs-mobile-drawer');
    if (!drawer) return;

    const panel = drawer.querySelector('.gs-drawer__panel');
    const contentArea = drawer.querySelector('.gs-drawer__content');
    const openBtns = document.querySelectorAll('[data-gs-open]');
    const closeBtns = drawer.querySelectorAll('[data-gs-close]');
    const tabs = drawer.querySelectorAll('[data-gs-tab]');
    const submenuBtns = drawer.querySelectorAll('[data-gs-submenu]');
    const backBtns = drawer.querySelectorAll('[data-gs-back]');
    const langOptions = drawer.querySelectorAll('.gs-drawer__lang-option');

    let submenuStack = [];
    let isOpen = false;
    let savedScrollY = 0;

    // ── Open Drawer ──
    function openDrawer() {
      if (isOpen) return;
      isOpen = true;

      // Lock body scroll while preserving the current scroll position
      // (prevents the page from jumping to the top, which felt buggy)
      savedScrollY = window.scrollY || window.pageYOffset || 0;
      document.body.style.top = '-' + savedScrollY + 'px';
      document.body.classList.add('gs-drawer-body-lock');

      // Step 1: make the drawer visible so the (one-time) layout/paint of the
      // preloaded content settles BEFORE the slide begins.
      drawer.classList.add('gs-drawer--visible');
      drawer.setAttribute('aria-hidden', 'false');

      // Force the browser to flush layout now (reads offsetWidth).
      void drawer.offsetWidth;

      // Step 2: on the next frame, trigger the slide-in transform. Because the
      // reflow is already done, the animation runs on the compositor smoothly.
      requestAnimationFrame(() => {
        drawer.classList.add('gs-drawer--open');
      });

      // Update hamburger
      openBtns.forEach(btn => btn.setAttribute('aria-expanded', 'true'));

      // Move focus AFTER the animation so it doesn't cause a mid-slide repaint.
      setTimeout(() => {
        if (!isOpen) return;
        const closeBtn = drawer.querySelector('.gs-drawer__close');
        if (closeBtn) closeBtn.focus({ preventScroll: true });
      }, 380);
    }

    // ── Close Drawer ──
    function closeDrawer() {
      if (!isOpen) return;
      isOpen = false;
      drawer.classList.remove('gs-drawer--open');
      drawer.setAttribute('aria-hidden', 'true');

      // Restore body scroll + position
      document.body.classList.remove('gs-drawer-body-lock');
      document.body.style.top = '';
      window.scrollTo(0, savedScrollY);

      // Remove the "visible" state and close submenus after the slide-out ends.
      setTimeout(() => {
        if (isOpen) return; // guard against a rapid re-open
        drawer.classList.remove('gs-drawer--visible');
        closeAllSubmenus();
      }, 350);

      // Update hamburger
      openBtns.forEach(btn => btn.setAttribute('aria-expanded', 'false'));
    }

    // ── Tab Switching ──
    function switchTab(tabIndex) {
      // Close any open submenu first
      closeAllSubmenus();

      tabs.forEach(tab => {
        const idx = tab.dataset.gsTab;
        const tabPanel = document.getElementById('gs-category-' + idx);

        if (idx === tabIndex) {
          tab.classList.add('gs-drawer__tab--active');
          tab.setAttribute('aria-selected', 'true');
          if (tabPanel) {
            tabPanel.classList.add('gs-drawer__panel-category--active');
            tabPanel.removeAttribute('hidden');
          }
        } else {
          tab.classList.remove('gs-drawer__tab--active');
          tab.setAttribute('aria-selected', 'false');
          if (tabPanel) {
            tabPanel.classList.remove('gs-drawer__panel-category--active');
            tabPanel.setAttribute('hidden', '');
          }
        }
      });

      // Scroll content to top when switching tabs
      if (contentArea) contentArea.scrollTop = 0;
    }

    // ── Open Submenu (stack-based: does NOT close parent) ──
    function openSubmenu(submenuId) {
      const submenu = document.getElementById(submenuId);
      if (!submenu) return;

      // Only close sibling submenus at the same depth, not the entire stack
      // Find and close any submenu at the same nesting level
      if (submenuStack.length > 0) {
        const currentTop = submenuStack[submenuStack.length - 1];
        // If the new submenu is NOT inside the current top, close the current top (sibling case)
        if (!currentTop.contains(submenu)) {
          popSubmenu(currentTop);
        }
      }

      submenu.classList.add('gs-drawer__submenu--open');
      submenu.setAttribute('aria-hidden', 'false');

      const btn = drawer.querySelector('[data-gs-submenu="' + submenuId + '"]');
      if (btn) btn.setAttribute('aria-expanded', 'true');

      submenuStack.push(submenu);
      panel.classList.add('gs-drawer__panel--submenu-open');
    }

    // ── Pop top submenu off stack ──
    function popSubmenu(submenu) {
      if (!submenu) return;
      submenu.classList.remove('gs-drawer__submenu--open');
      submenu.setAttribute('aria-hidden', 'true');

      const submenuId = submenu.id;
      const btn = drawer.querySelector('[data-gs-submenu="' + submenuId + '"]');
      if (btn) btn.setAttribute('aria-expanded', 'false');

      const idx = submenuStack.indexOf(submenu);
      if (idx !== -1) submenuStack.splice(idx, 1);

      if (submenuStack.length === 0) {
        panel.classList.remove('gs-drawer__panel--submenu-open');
      }
    }

    // ── Close Submenu (called by back button — closes this level and anything above) ──
    function closeSubmenu(submenu) {
      if (!submenu) return;

      // Close this submenu and all children above it in the stack
      const idx = submenuStack.indexOf(submenu);
      if (idx !== -1) {
        // Close everything from idx upward
        const toClose = submenuStack.splice(idx);
        toClose.reverse().forEach(sub => {
          sub.classList.remove('gs-drawer__submenu--open');
          sub.setAttribute('aria-hidden', 'true');
          const sid = sub.id;
          const btn = drawer.querySelector('[data-gs-submenu="' + sid + '"]');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        });
      } else {
        // Fallback: just close this one
        submenu.classList.remove('gs-drawer__submenu--open');
        submenu.setAttribute('aria-hidden', 'true');
      }

      if (submenuStack.length === 0) {
        panel.classList.remove('gs-drawer__panel--submenu-open');
      }
    }

    function closeAllSubmenus() {
      drawer.querySelectorAll('.gs-drawer__submenu--open').forEach(sub => {
        sub.classList.remove('gs-drawer__submenu--open');
        sub.setAttribute('aria-hidden', 'true');
      });
      drawer.querySelectorAll('[data-gs-submenu]').forEach(btn => {
        btn.setAttribute('aria-expanded', 'false');
      });
      panel.classList.remove('gs-drawer__panel--submenu-open');
      submenuStack = [];
    }

    // ── Event Listeners ──
    openBtns.forEach(btn => btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      openDrawer();
    }));

    closeBtns.forEach(btn => btn.addEventListener('click', (e) => {
      e.preventDefault();
      closeDrawer();
    }));

    // Trigger existing search modal
    const searchFakeInput = drawer.querySelector('[data-gs-search-trigger]');
    if (searchFakeInput) {
      searchFakeInput.addEventListener('click', (e) => {
        e.preventDefault();
        const mainSearchBtn = document.querySelector('.header__icon--search');
        if (mainSearchBtn) {
          closeDrawer();
          setTimeout(() => mainSearchBtn.click(), 50); // slight delay to allow drawer to close
        }
      });
    }

    tabs.forEach(tab => tab.addEventListener('click', () => {
      switchTab(tab.dataset.gsTab);
    }));

    // Cart icon inside drawer → close menu drawer, open cart drawer
    const cartIconDrawer = drawer.querySelector('[data-gs-open-cart]');
    if (cartIconDrawer) {
      cartIconDrawer.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeDrawer();
        setTimeout(() => {
          const cartDrawerEl = document.querySelector('wi-cartdrawer');
          if (cartDrawerEl && typeof cartDrawerEl.openCart === 'function') {
            cartDrawerEl.openCart();
          }
        }, 100);
      });
    }

    // Use event delegation for submenu buttons (handles dynamically relevant submenus)
    drawer.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-gs-submenu]');
      if (btn && drawer.contains(btn)) {
        e.stopPropagation();
        openSubmenu(btn.dataset.gsSubmenu);
        return;
      }
      const backBtn = e.target.closest('[data-gs-back]');
      if (backBtn && drawer.contains(backBtn)) {
        e.stopPropagation();
        const submenu = backBtn.closest('.gs-drawer__submenu');
        closeSubmenu(submenu);
        return;
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        if (submenuStack.length > 0) {
          closeSubmenu(submenuStack[submenuStack.length - 1]);
        } else {
          closeDrawer();
        }
      }
    });

    // Language switcher
    langOptions.forEach(opt => {
      opt.addEventListener('click', (e) => {
        e.preventDefault();
        const langCode = opt.dataset.languageCode;
        const form = opt.closest('form');
        const input = form ? form.querySelector('input[name="language_code"]') : null;
        if (input && form) {
          input.value = langCode;
          form.submit();
        }
      });
    });

    // Initialize aria state
    drawer.setAttribute('aria-hidden', 'true');
  })();
</script>
