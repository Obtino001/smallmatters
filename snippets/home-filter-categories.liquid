{%- comment -%}
  Lists store collections for the homepage filter drawer.
  Params:
    - section: section object (optional category_menu)
    - stock_param: append ?filter.v.availability=1 to collection links (default true)
{%- endcomment -%}

{%- liquid
  assign append_stock = stock_param | default: true
  assign stock_query = ''
  if append_stock
    assign stock_query = '?filter.v.availability=1'
  endif
-%}

<ul class="home-filter-categories">
  {%- if collections.all != blank -%}
    <li>
      <a class="home-filter-category" href="{{ collections.all.url }}{{ stock_query }}">
        {{ collections.all.title }}
      </a>
    </li>
  {%- endif -%}

  {%- for col in collections -%}
    {%- liquid
      if col.handle == 'frontpage' or col.handle == 'all'
        continue
      endif
      if col.products_count == 0 and col.all_products_count == 0
        continue
      endif
    -%}
    <li>
      <a class="home-filter-category" href="{{ col.url }}{{ stock_query }}">
        {{ col.title }}
      </a>
    </li>
  {%- endfor -%}

  {%- if section.settings.category_menu != blank -%}
    {%- for link in section.settings.category_menu.links -%}
      {%- unless link.url contains '/collections/' -%}
        {%- continue -%}
      {%- endunless -%}
      <li>
        <a class="home-filter-category home-filter-category--menu" href="{{ link.url }}{{ stock_query }}">
          {{ link.title }}
        </a>
      </li>
      {%- for child in link.links -%}
        {%- unless child.url contains '/collections/' -%}
          {%- continue -%}
        {%- endunless -%}
        <li>
          <a class="home-filter-category home-filter-category--menu home-filter-category--child" href="{{ child.url }}{{ stock_query }}">
            {{ child.title }}
          </a>
        </li>
      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}
</ul>
