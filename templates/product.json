    "about_us_qoute_heading_CNiiwV": {
      "type": "about-us-qoute-heading",
      "blocks": {
        "feature_y8f84R": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/Vector_34.svg",
            "title": "Norsk design",
            "text": "Vi er et kvinnelig gründerselskap som designer i Norge, og produserer både her og i Indre Mongolia."
          }
        },
        "feature_4CPLkF": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/Group_1413372198.svg",
            "title": "Rask levering",
            "text": "Vi holder til på Vinderen i Oslo. Herfra sender vi varer til hele landet med leveringstid på 1-3 dager."
          }
        },
        "feature_jyd8UH": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/Vector_35.svg",
            "title": "Ekte kundeservice",
            "text": "Hos oss får du personlig kundeservice og ikke automatiserte svar. Vi ønsker å prate med deg!"
          }
        },
        "feature_dW9FJ7": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/Group_10.svg",
            "title": "God kvalitet",
            "text": "Små produksjoner gir deg plagg som er like, men alltid unike. Hos oss finner du kun tidløse plagg i god kvalitet."
          }
        }
      },
      "block_order": [
        "feature_y8f84R",
        "feature_4CPLkF",
        "feature_jyd8UH",
        "feature_dW9FJ7"
      ],
      "name": "Why Choose",
      "settings": {
        "padding_top": 50,
        "padding_bottom": 50,
        "padding_top_mobile": 30,
        "padding_bottom_mobile": 30,
        "bg_color": "#eae5df",
        "main_heading": "Hvorfor velge Smallmatters?",
        "main_text": "<p>Smallmatters startet med en visjon om å redusere avfall ved å bruke overskuddsmaterialer og restegarn. I dag er hvert produkt laget av naturlige fibre eller gjenbruksmaterialer, i begrensede opplag. Fordi luksus skal føles bra for deg, og for verden rundt deg.</p>"
      }
    },
    "about_slider_CyL9C3": {
      "type": "about-slider",
      "blocks": {
        "slide_bQRxP4": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/df97f18b04280600270d210c095aec2e6e1a9b42_2.png",
            "title": "Om oss",
            "text": "<p>Vi startet Smallmatters med en idé: at små ting kan gjøre en forskjell. Denne ideen inspirerte oss, Line Houge og Janicke Lorange, til å starte opp i 2018. <a href=\"/pages/om-oss-2\" title=\"Om Oss\">Les mer</a></p>",
            "btn_label": "",
            "btn_link": "shopify://pages/om-oss-2",
            "enable_grayscale": false
          }
        },
        "slide_AyKgXf": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/Vare_kvaliteter.png",
            "title": "Våre kvaliteter",
            "text": "<p>Mange tror at kashmirull kommer fra Italia, men den eksklusive ullen stammer fra ulike geiteraser som hovedsakelig lever i de kalde strøkene i Kina og Mongolia. <a href=\"/pages/vare-kvaliteter\" title=\"Våre kvaliteter\">Les mer</a></p>",
            "btn_label": "",
            "btn_link": "shopify://pages/vare-kvaliteter",
            "enable_grayscale": false
          }
        },
        "slide_YGpjhT": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/8e25c741820428157488fa3918e5a4f6943dae73.jpg",
            "title": "Våre design",
            "text": "<p>Design med tydelig identitet. Alt vi lager er designet i Norge med respekt for materialene, menneskene og historiene bak produktene. <a href=\"/pages/vare-design\" title=\"Våre design\">Les mer</a></p>",
            "btn_label": "",
            "btn_link": "shopify://pages/vare-design",
            "enable_grayscale": false
          }
        },
        "slide_834HEQ": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/Bevisste_valg_1.png",
            "title": "Bevisste valg",
            "text": "<p>Hos Smallmatters tar vi bevisste valg for å gjøre en forskjell: vi bruker rene, naturlige fibre og overskuddsmaterialer i produksjonen vår. <a href=\"/pages/bevisste-valg\" title=\"Bevisste valg\">Les mer</a></p>",
            "btn_label": "",
            "btn_link": "shopify://pages/bevisste-valg",
            "enable_grayscale": false
          }
        },
        "slide_zw68CU": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/Vare_produksjoner.png",
            "title": "Våre produksjoner",
            "text": "<p>Fra myk kashmir i Indre Mongolia, til bærekraftige tekstiler laget av overskuddsmaterialer, sydd lokalt i Oslo. <a href=\"/pages/vare-produksjoner\" title=\"Våre produksjoner\">Les mer</a></p>",
            "btn_label": "",
            "btn_link": "shopify://pages/vare-produksjoner",
            "enable_grayscale": false
          }
        }
      },
      "block_order": [
        "slide_bQRxP4",
        "slide_AyKgXf",
        "slide_YGpjhT",
        "slide_834HEQ",
        "slide_zw68CU"
      ],
